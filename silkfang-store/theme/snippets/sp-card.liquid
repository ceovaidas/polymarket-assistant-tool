{%- comment -%} Product card: second photo on hover, real compare-at price only, colour count. {%- endcomment -%}
{%- assign v = card.selected_or_first_available_variant -%}
<a class="sp-card" href="{{ card.url }}">
  <span class="sp-card__img">
    {%- if card.featured_media -%}{{ card.featured_media.preview_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: card.title, sizes: '(min-width: 990px) 25vw, 50vw' }}{%- else -%}{{ 'apparel-1' | placeholder_svg_tag }}{%- endif -%}
    {%- if card.media[1] -%}<span class="sp-card__alt">{{ card.media[1].preview_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}</span>{%- endif -%}
    {%- unless card.available -%}<em class="sp-card__badge">Sold out</em>{%- endunless -%}
  </span>
  <span class="sp-card__t">{{ card.title }}</span>
  {%- assign colours = 0 -%}
  {%- for opt in card.options_with_values -%}{%- assign on = opt.name | downcase -%}{%- if on contains 'colo' -%}{%- assign colours = opt.values.size -%}{%- endif -%}{%- endfor -%}
  <span class="sp-card__p">{{ v.price | money }}{% if v.compare_at_price > v.price %} <s>{{ v.compare_at_price | money }}</s>{% endif %}{% if colours > 1 %}<i>{{ colours }} colours</i>{% endif %}</span>
</a>
