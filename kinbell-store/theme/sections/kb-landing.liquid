{%- comment -%}
  One-product landing page. Used on the home page (product picked in the section settings) and on the
  product page (the current product). Everything here must stay true: real rating from the reviews app,
  real delivery window, bundle prices that match the automatic discounts set up in Shopify.
{%- endcomment -%}
{%- liquid
  assign p = product
  if p == blank
    assign p = section.settings.product
  endif
  if p != blank
    assign v = p.selected_or_first_available_variant
    assign unit = v.price
  else
    assign unit = 5999
  endif
  assign rating = p.metafields.reviews.rating.value.rating | default: p.metafields.reviews.rating.value
  assign rating_count = p.metafields.reviews.rating_count.value | default: 0
  assign brand = shop.name
-%}
{{ 'kb.css' | asset_url | stylesheet_tag }}

<div class="kb" id="kb-top" data-kb data-unit="{{ unit }}" data-ship-min="{{ section.settings.ship_min }}" data-ship-max="{{ section.settings.ship_max }}">

  {%- comment -%} ===== HERO: gallery + buy box ===== {%- endcomment -%}
  <section class="kb-hero kb-wrap">
    <div class="kb-gallery" data-kb-gallery>
      <div class="kb-gallery__main">
        {%- if p.media.size > 0 -%}
          {%- for m in p.media limit: 8 -%}
            <figure class="kb-gallery__slide{% if forloop.first %} is-on{% endif %}" data-kb-slide="{{ forloop.index0 }}">
              {{ m.preview_image | image_url: width: 1100 | image_tag: loading: 'eager', sizes: '(min-width: 900px) 50vw, 100vw', alt: m.alt | default: p.title }}
            </figure>
          {%- endfor -%}
        {%- else -%}
          <figure class="kb-gallery__slide is-on kb-ph">{{ 'product-1' | placeholder_svg_tag }}</figure>
        {%- endif -%}
        {%- if section.settings.photo_badge != blank -%}<span class="kb-gallery__badge">{{ section.settings.photo_badge }}</span>{%- endif -%}
      </div>
      {%- if p.media.size > 1 -%}
        <div class="kb-gallery__thumbs" role="tablist" aria-label="Product photos">
          {%- for m in p.media limit: 8 -%}
            <button type="button" class="kb-thumb{% if forloop.first %} is-on{% endif %}" data-kb-thumb="{{ forloop.index0 }}" aria-label="Photo {{ forloop.index }}">
              {{ m.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="kb-buy" id="kb-buy">
      {%- if section.settings.eyebrow != blank -%}<p class="kb-pill">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if rating != blank and rating_count > 0 -%}
        <a class="kb-rating" href="#kb-reviews">
          <span class="kb-stars" style="--r: {{ rating | times: 20 }}%" aria-hidden="true"></span>
          <b>{{ rating | round: 1 }}</b>
          <span>{{ rating_count }} review{% if rating_count != 1 %}s{% endif %}{% if section.settings.review_source != blank %} · {{ section.settings.review_source }}{% endif %}</span>
        </a>
      {%- endif -%}
      <h1 class="kb-h1">{{ section.settings.headline | default: p.title }}</h1>

      {%- if section.settings.subhead != blank -%}<p class="kb-sub">{{ section.settings.subhead }}</p>{%- endif -%}

      {%- assign bullets = section.settings.bullets | newline_to_br | split: '<br />' -%}
      <ul class="kb-ticks">
        {%- for b in bullets -%}{%- assign t = b | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
      </ul>

      {%- form 'product', p, class: 'kb-form', data-kb-form: '' -%}
        {%- if section.settings.go_to_checkout -%}<input type="hidden" name="return_to" value="/checkout">{%- endif -%}
        <input type="hidden" name="quantity" value="1" data-kb-qty>

        {%- if p.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ v.id }}">
        {%- else -%}
          <label class="kb-label" for="kb-variant-{{ section.id }}">{{ p.options.first }}</label>
          <select class="kb-select" id="kb-variant-{{ section.id }}" name="id" data-kb-variant>
            {%- for vv in p.variants -%}
              <option value="{{ vv.id }}" data-price="{{ vv.price }}"{% if vv.id == v.id %} selected{% endif %}{% unless vv.available %} disabled{% endunless %}>{{ vv.title }}{% unless vv.available %} (sold out){% endunless %}</option>
            {%- endfor -%}
          </select>
        {%- endif -%}

        <fieldset class="kb-tiers">
          <legend class="kb-label">{{ section.settings.tiers_title }}</legend>
          {%- for i in (1..3) -%}
            {%- liquid
              assign qk = 'tier' | append: i | append: '_qty'
              assign q = section.settings[qk]
              assign lk = 'tier' | append: i | append: '_label'
              assign nk = 'tier' | append: i | append: '_note'
              assign bk = 'tier' | append: i | append: '_badge'
              assign ok = 'tier' | append: i | append: '_off'
              assign off_cents = section.settings[ok] | times: 100 | round
              assign full = unit | times: q
              assign price = full | minus: off_cents
            -%}
            {%- if q > 0 -%}
              <label class="kb-tier{% if i == section.settings.default_tier %} is-on{% endif %}">
                <input type="radio" name="kb-tier" value="{{ q }}" data-off="{{ off_cents }}"{% if i == section.settings.default_tier %} checked{% endif %}>
                <span class="kb-tier__dot" aria-hidden="true"></span>
                {%- if p.featured_media != blank -%}
                  <span class="kb-tier__img">{{ p.featured_media.preview_image | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' }}{%- if q > 1 -%}<i>×{{ q }}</i>{%- endif -%}</span>
                {%- endif -%}
                <span class="kb-tier__main">
                  <b>{{ section.settings[lk] }}</b>
                  {%- if section.settings[nk] != blank -%}<small>{{ section.settings[nk] }}</small>{%- endif -%}
                </span>
                <span class="kb-tier__price">
                  <b data-kb-tier-price>{{ price | money }}</b>
                  {%- if off_cents > 0 -%}<s data-kb-tier-full>{{ full | money }}</s><small class="kb-tier__save" data-kb-tier-save>${{ section.settings[ok] }} to spend</small>{%- endif -%}
                </span>
                {%- if section.settings[bk] != blank -%}<span class="kb-tier__badge">{{ section.settings[bk] }}</span>{%- endif -%}
              </label>
            {%- endif -%}
          {%- endfor -%}
        </fieldset>

        <button type="submit" class="kb-btn kb-btn--big" data-kb-submit{% unless v.available or p == blank %} disabled{% endunless %}>
          <span>{{ section.settings.cta }}</span> · <span data-kb-cta-price>{{ unit | money }}</span>
        </button>
      {%- endform -%}

      <p class="kb-eta" data-kb-eta>
        {%- render 'kb-icon', name: 'truck' -%}
        <span>Order today, delivered in <b>{{ section.settings.ship_min }}–{{ section.settings.ship_max }} business days</b>{% if section.settings.ship_note != blank %} · {{ section.settings.ship_note }}{% endif %}</span>
      </p>

      <ul class="kb-assure">
        {%- for i in (1..3) -%}
          {%- assign ak = 'assure_' | append: i -%}
          {%- if section.settings[ak] != blank -%}<li>{%- render 'kb-icon', name: 'check' -%}{{ section.settings[ak] }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="kb-pay kb-pay--buy" aria-label="Payment methods">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}</ul>
      {%- endif -%}

      <div class="kb-tabs">
        {%- for i in (1..3) -%}
          {%- assign tt = 'tab' | append: i | append: '_title' -%}{%- assign tx = 'tab' | append: i | append: '_text' -%}
          {%- if section.settings[tt] != blank -%}
            <details class="kb-tab"{% if i == 1 %} open{% endif %}>
              <summary>{{ section.settings[tt] }}{%- render 'kb-icon', name: 'plus' -%}</summary>
              <div class="kb-rte">{{ section.settings[tx] }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== The rest: blocks in the order set in the editor ===== {%- endcomment -%}
  {%- assign faq_done = false -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'marquee' -%}
        {%- assign items = block.settings.items | split: '|' -%}
        <section class="kb-marquee" aria-label="{{ block.settings.items | escape }}" {{ block.shopify_attributes }}>
          <div class="kb-marquee__track" aria-hidden="true">
            {%- for n in (1..4) -%}{%- for it in items -%}<span>{{ it | strip }}</span><i>✦</i>{%- endfor -%}{%- endfor -%}
          </div>
        </section>

      {%- when 'icons' -%}
        <section class="kb-icons kb-wrap" {{ block.shopify_attributes }}>
          {%- assign rows = block.settings.items | newline_to_br | split: '<br />' -%}
          {%- for r in rows -%}{%- assign t = r | strip -%}{%- if t != blank -%}
            {%- assign c = t | split: '|' -%}
            <div class="kb-icons__item">
              {%- assign icn = c[0] | strip -%}
              <span class="kb-icons__ic">{%- render 'kb-icon', name: icn -%}</span>
              <b>{{ c[1] | strip }}</b>
              {%- if c[2] -%}<span>{{ c[2] | strip }}</span>{%- endif -%}
            </div>
          {%- endif -%}{%- endfor -%}
        </section>

      {%- when 'steps' -%}
        <section class="kb-band kb-steps" id="kb-how" {{ block.shopify_attributes }}>
          <div class="kb-wrap">
            <p class="kb-eyebrow">{{ block.settings.eyebrow }}</p>
            <h2 class="kb-h2">{{ block.settings.title }}</h2>
            <ol class="kb-steps__list">
              {%- for i in (1..3) -%}
                {%- assign tk = 'step' | append: i | append: '_title' -%}{%- assign dk = 'step' | append: i | append: '_text' -%}
                <li><span class="kb-steps__n">{{ i }}</span><h3>{{ block.settings[tk] }}</h3><p>{{ block.settings[dk] }}</p></li>
              {%- endfor -%}
            </ol>
          </div>
        </section>

      {%- when 'feature' -%}
        {%- liquid
          assign img = block.settings.image
          if img == blank and p.media.size > 0
            assign mi = block.settings.media_index | minus: 1
            assign img = p.media[mi].preview_image
          endif
        -%}
        <section class="kb-feature kb-wrap{% if block.settings.flip %} kb-feature--flip{% endif %}" {{ block.shopify_attributes }}>
          <div class="kb-feature__media">
            {%- if img != blank -%}{{ img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 45vw, 100vw', alt: block.settings.title }}{%- else -%}<div class="kb-ph">{{ 'image' | placeholder_svg_tag }}</div>{%- endif -%}
          </div>
          <div class="kb-feature__text">
            {%- if block.settings.eyebrow != blank -%}<p class="kb-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            <h2 class="kb-h2">{{ block.settings.title }}</h2>
            <div class="kb-rte">{{ block.settings.text }}</div>
          </div>
        </section>

      {%- when 'box' -%}
        <section class="kb-band kb-box" {{ block.shopify_attributes }}>
          <div class="kb-wrap">
            <h2 class="kb-h2">{{ block.settings.title }}</h2>
            {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
            <ul class="kb-box__list">
              {%- for it in items -%}{%- assign t = it | strip -%}{%- if t != blank -%}
                {%- assign parts = t | split: '|' -%}
                <li><b>{{ parts[0] | strip }}</b>{% if parts[1] %}<span>{{ parts[1] | strip }}</span>{% endif %}</li>
              {%- endif -%}{%- endfor -%}
            </ul>
          </div>
        </section>

      {%- when 'compare' -%}
        <section class="kb-compare kb-wrap" {{ block.shopify_attributes }}>
          <p class="kb-eyebrow">{{ block.settings.eyebrow }}</p>
          <h2 class="kb-h2">{{ block.settings.title }}</h2>
          <div class="kb-table" role="table" aria-label="{{ block.settings.title | escape }}">
            <div class="kb-tr kb-tr--head" role="row"><span role="columnheader"></span><span role="columnheader">{{ brand }}</span><span role="columnheader">{{ block.settings.them }}</span></div>
            {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
            {%- for r in rows -%}{%- assign t = r | strip -%}{%- if t != blank -%}
              {%- assign c = t | split: '|' -%}
              <div class="kb-tr" role="row">
                <span role="rowheader">{{ c[0] | strip }}</span>
                {%- for k in (1..2) -%}
                  {%- assign cell = c[k] | strip -%}
                  <span role="cell" class="{% if cell == 'yes' %}is-yes{% elsif cell == 'no' %}is-no{% endif %}">
                    {%- if cell == 'yes' -%}{%- render 'kb-icon', name: 'check' -%}<span class="kb-sr">Yes</span>{%- elsif cell == 'no' -%}{%- render 'kb-icon', name: 'x' -%}<span class="kb-sr">No</span>{%- else -%}{{ cell }}{%- endif -%}
                  </span>
                {%- endfor -%}
              </div>
            {%- endif -%}{%- endfor -%}
          </div>
          {%- if block.settings.note != blank -%}<p class="kb-note">{{ block.settings.note }}</p>{%- endif -%}
        </section>

      {%- when 'limits' -%}
        <section class="kb-limits kb-wrap" {{ block.shopify_attributes }}>
          <div class="kb-limits__card">
            <h2 class="kb-h3">{{ block.settings.title }}</h2>
            <div class="kb-rte">{{ block.settings.text }}</div>
          </div>
        </section>

      {%- when 'reviews' -%}
        <section class="kb-reviews kb-wrap" id="kb-reviews" {{ block.shopify_attributes }}>
          <h2 class="kb-h2">{{ block.settings.title }}</h2>
          {%- if rating != blank and rating_count > 0 -%}
            <p class="kb-reviews__sum"><span class="kb-stars kb-stars--lg" style="--r: {{ rating | times: 20 }}%" aria-hidden="true"></span> <b>{{ rating | round: 1 }} out of 5</b> · {{ rating_count }} reviews{% if section.settings.review_source != blank %} · {{ section.settings.review_source }}{% endif %}</p>
          {%- endif -%}
          {%- liquid
            assign review_count = 0
            for r in section.blocks
              if r.type == 'review'
                assign review_count = review_count | plus: 1
              endif
            endfor
          -%}
          {%- if review_count == 0 and request.design_mode != false -%}
            <p class="kb-empty">Add "Review" blocks with real reviews copied from the AliExpress listing, or add the Judge.me / Loox app block here. This box is only visible in the theme editor.</p>
          {%- endif -%}
          <div class="kb-reviews__grid">
            {%- for r in section.blocks -%}{%- if r.type == 'review' -%}
              <figure class="kb-review" {{ r.shopify_attributes }}>
                {%- if r.settings.image != blank -%}{{ r.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: 'Photo from the reviewer' }}{%- endif -%}
                <span class="kb-stars" style="--r: {{ r.settings.stars | times: 20 }}%" role="img" aria-label="{{ r.settings.stars }} out of 5 stars"></span>
                <blockquote>{{ r.settings.text }}</blockquote>
                <figcaption><b>{{ r.settings.name }}</b>{% if r.settings.meta != blank %} · {{ r.settings.meta }}{% endif %}</figcaption>
              </figure>
            {%- endif -%}{%- endfor -%}
          </div>
          {%- if block.settings.note != blank -%}<p class="kb-note">{{ block.settings.note }}</p>{%- endif -%}
        </section>

      {%- when '@app' -%}
        <div class="kb-wrap kb-app">{% render block %}</div>

      {%- when 'faq' -%}
        {%- unless faq_done -%}
          {%- assign faq_done = true -%}
          <section class="kb-faq kb-wrap" id="kb-faq">
            <h2 class="kb-h2">Questions, answered</h2>
            {%- for f in section.blocks -%}{%- if f.type == 'faq' -%}
              <details class="kb-faq__item" {{ f.shopify_attributes }}>
                <summary>{{ f.settings.q }}{%- render 'kb-icon', name: 'plus' -%}</summary>
                <div class="kb-rte">{{ f.settings.a }}</div>
              </details>
            {%- endif -%}{%- endfor -%}
          </section>
        {%- endunless -%}

      {%- when 'promise' -%}
        <section class="kb-promise" {{ block.shopify_attributes }}>
          <div class="kb-wrap kb-promise__in">
            {%- render 'kb-icon', name: 'shield' -%}
            <div><h2 class="kb-h3">{{ block.settings.title }}</h2><p>{{ block.settings.text }}</p></div>
          </div>
        </section>

      {%- when 'final_cta' -%}
        <section class="kb-final kb-wrap" {{ block.shopify_attributes }}>
          <h2 class="kb-h2">{{ block.settings.title }}</h2>
          <p>{{ block.settings.text }}</p>
          <a class="kb-btn kb-btn--big" href="#kb-buy" data-kb-jump>{{ section.settings.cta }}</a>
        </section>
    {%- endcase -%}
  {%- endfor -%}

  {%- comment -%} Sticky bar on phones: always one tap away from ordering {%- endcomment -%}
  <div class="kb-sticky" data-kb-sticky aria-hidden="true">
    {%- if p.featured_media != blank -%}<span class="kb-sticky__img">{{ p.featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</span>{%- endif -%}
    <div class="kb-sticky__txt"><b>{{ section.settings.sticky_title | default: p.title }}</b><span data-kb-sticky-price>{{ unit | money }}</span></div>
    <a class="kb-btn" href="#kb-buy" data-kb-jump tabindex="-1">{{ section.settings.cta }}</a>
  </div>
</div>

<script src="{{ 'kb.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "One-product landing",
  "tag": "div",
  "class": "kb-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (home page)", "info": "On the product page the current product is used." },
    { "type": "header", "content": "Top of the page" },
    { "type": "text", "id": "eyebrow", "label": "Small line above the title", "default": "For parents who live alone" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "One press. Family knows instantly." },
    { "type": "textarea", "id": "subhead", "label": "Short description", "default": "A waterproof SOS button for Mom or Dad. One press sounds the alarm in the house and sends an alert to up to 20 family phones through the free app, wherever you are." },
    { "type": "textarea", "id": "bullets", "label": "Benefit ticks (one per line)", "default": "No monthly fee, no contract\nWrist button + neck pendant, both waterproof\nBattery lasts over a year, backup power in a power cut" },
    { "type": "text", "id": "photo_badge", "label": "Badge on the photo", "default": "$0 monthly fees" },
    { "type": "text", "id": "review_source", "label": "Where the reviews come from", "default": "verified AliExpress buyers", "info": "Shown next to the rating. Keep it true: if reviews are imported from AliExpress, say so." },
    { "type": "header", "content": "Tabs under the button" },
    { "type": "text", "id": "tab1_title", "label": "Tab 1", "default": "Why families choose it" },
    { "type": "richtext", "id": "tab1_text", "label": "Tab 1 text", "default": "<p>Most falls happen when nobody is around and the phone is out of reach. This button stays on the wrist or around the neck, so help is one press away in any room, even the bathroom.</p>" },
    { "type": "text", "id": "tab2_title", "label": "Tab 2", "default": "Specifications" },
    { "type": "richtext", "id": "tab2_text", "label": "Tab 2 text", "default": "<ul><li><strong>In the box:</strong> SOS wristwatch button, SOS pendant button, Wi-Fi receiver with plug</li><li><strong>Button range:</strong> about 100 ft indoors, 300 ft in open space</li><li><strong>Button battery:</strong> CR2032, included, lasts 12+ months</li><li><strong>Receiver:</strong> wall plug, alarm sound + LED, 5 volume levels, 5-hour backup battery</li><li><strong>App:</strong> Smart Life / Tuya, free, up to 20 family members</li><li><strong>Works with:</strong> Alexa, Google Home (2.4 GHz Wi-Fi only)</li><li><strong>Buttons:</strong> waterproof</li></ul>" },
    { "type": "text", "id": "tab3_title", "label": "Tab 3", "default": "Shipping & returns" },
    { "type": "richtext", "id": "tab3_text", "label": "Tab 3 text", "default": "<p>$0 shipping, on us. Orders ship within 1–3 business days and arrive in 7–14 business days with tracking. Not right for your family? Send it back within 30 days of delivery for a full refund.</p>" },
    { "type": "header", "content": "Bundles" },
    { "type": "paragraph", "content": "Prices = product price × quantity − the amount below. Create matching automatic discounts in Shopify (Discounts → Amount off products, fixed amount, minimum quantity) so checkout charges exactly what is shown here." },
    { "type": "text", "id": "tiers_title", "label": "Bundle title", "default": "Choose your set" },
    { "type": "range", "id": "default_tier", "label": "Pre-selected bundle", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "number", "id": "tier1_qty", "label": "Bundle 1: quantity", "default": 1 },
    { "type": "text", "id": "tier1_label", "label": "Bundle 1: name", "default": "1 set" },
    { "type": "text", "id": "tier1_note", "label": "Bundle 1: note", "default": "For one parent" },
    { "type": "text", "id": "tier1_off", "label": "Bundle 1: $ off (e.g. 19.99)", "default": "0" },
    { "type": "text", "id": "tier1_badge", "label": "Bundle 1: badge" },
    { "type": "number", "id": "tier2_qty", "label": "Bundle 2: quantity", "default": 2 },
    { "type": "text", "id": "tier2_label", "label": "Bundle 2: name", "default": "2 sets" },
    { "type": "text", "id": "tier2_note", "label": "Bundle 2: note", "default": "Both parents, or two floors" },
    { "type": "text", "id": "tier2_off", "label": "Bundle 2: $ off (e.g. 19.99)", "default": "19.99" },
    { "type": "text", "id": "tier2_badge", "label": "Bundle 2: badge", "default": "Most chosen" },
    { "type": "number", "id": "tier3_qty", "label": "Bundle 3: quantity (0 hides it)", "default": 3 },
    { "type": "text", "id": "tier3_label", "label": "Bundle 3: name", "default": "3 sets" },
    { "type": "text", "id": "tier3_note", "label": "Bundle 3: note", "default": "Grandparents' home + a spare" },
    { "type": "text", "id": "tier3_off", "label": "Bundle 3: $ off (e.g. 19.99)", "default": "44.98" },
    { "type": "text", "id": "tier3_badge", "label": "Bundle 3: badge", "default": "Best value" },
    { "type": "header", "content": "Button and delivery" },
    { "type": "text", "id": "cta", "label": "Button text", "default": "Get peace of mind" },
    { "type": "checkbox", "id": "go_to_checkout", "label": "Button goes straight to checkout", "default": true },
    { "type": "text", "id": "sticky_title", "label": "Sticky bar title (phones)" },
    { "type": "range", "id": "ship_min", "label": "Delivery: fastest (business days, incl. processing)", "min": 1, "max": 30, "step": 1, "default": 7 },
    { "type": "range", "id": "ship_max", "label": "Delivery: slowest (business days, incl. processing)", "min": 2, "max": 40, "step": 1, "default": 14 },
    { "type": "text", "id": "ship_note", "label": "Delivery note", "default": "$0 shipping, on us" },
    { "type": "text", "id": "assure_1", "label": "Reassurance 1", "default": "30-day returns" },
    { "type": "text", "id": "assure_2", "label": "Reassurance 2", "default": "Secure checkout" },
