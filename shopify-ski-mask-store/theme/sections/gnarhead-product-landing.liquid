{%- comment -%}
  GNARHEAD — one-product landing section.
  Works in any Online Store 2.0 theme (Dawn recommended). Assign the "product.landing"
  template to the ski mask product. Requires snippets/gnarhead-icon.liquid.
{%- endcomment -%}

{{ 'gnarhead-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gnarhead-landing.js' | asset_url }}" defer></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count
  assign tones = section.settings.placeholder_tones | split: ','
  assign tone_count = tones.size
  assign chars = section.blocks | where: 'type', 'character'
  assign specs = section.blocks | where: 'type', 'spec'
  assign features = section.blocks | where: 'type', 'feature'
  assign videos = section.blocks | where: 'type', 'video'
  assign reviews = section.blocks | where: 'type', 'review'
  assign faqs = section.blocks | where: 'type', 'faq'
-%}

<div class="gh" data-gh-root id="gh-{{ section.id }}">

  {%- comment -%} ================= PRODUCT ================= {%- endcomment -%}
  <section class="gh-product">
    <div class="gh-product__grid">

      <div class="gh-gallery">
        <div class="gh-gallery__track" data-gh-track>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <figure class="gh-gallery__item gh-media" data-media-id="{{ media.id }}" {% if forloop.first %}data-gh-hero{% endif %}>
                {%- if media.media_type == 'image' -%}
                  {%- if forloop.first -%}
                    {{ media | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 60vw, 100vw', alt: media.alt | default: product.title }}
                  {%- else -%}
                    {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, 100vw', alt: media.alt | default: product.title }}
                  {%- endif -%}
                {%- elsif media.media_type == 'video' -%}
                  {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}
                {%- else -%}
                  {{ media | media_tag }}
                {%- endif -%}
              </figure>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..5) -%}
              {%- assign t = forloop.index0 | modulo: tone_count -%}
              <figure class="gh-gallery__item gh-media" style="--tone: {{ tones[t] | strip }}" {% if forloop.first %}data-gh-hero{% endif %}>
                <div class="gh-ph">{% render 'gnarhead-icon', name: 'mask' %}<span class="gh-ph__cap gh-mono">Photo {{ i }} — upload in Products</span></div>
              </figure>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <span class="gh-gallery__count gh-mono" data-gh-count>1 / {{ product.media.size | at_least: 5 }}</span>
      </div>

      <div class="gh-buy">
        <div class="gh-buy__inner">
          <div class="gh-buy__meta gh-mono"><span>{{ section.settings.meta_left }}</span><span>{{ section.settings.meta_right }}</span></div>

          <h1 class="gh-buy__title gh-display">{{ product.title }}</h1>

          {%- if rating != blank -%}
            <div class="gh-buy__rating">{% render 'gnarhead-icon', name: 'stars' %}<span>{{ rating.rating | round: 1 }} · {{ rating_count }} reviews</span></div>
          {%- endif -%}

          {%- if section.settings.lede != blank -%}<p class="gh-buy__lede">{{ section.settings.lede }}</p>{%- endif -%}

          <div class="gh-price">
            <span class="gh-price__now" data-gh-price>{{ current_variant.price | money }}</span>
            <s class="gh-price__was" data-gh-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
            <span class="gh-price__save gh-mono" data-gh-save hidden></span>
          </div>

          {%- assign gh_form_id = 'gh-form-' | append: section.id -%}
          {%- form 'product', product, id: gh_form_id, data-gh-form: 'true' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-gh-variant-id>
            <input type="hidden" name="quantity" value="1" data-gh-qty>

            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                {%- assign option_index = forloop.index0 -%}
                {%- assign is_swatch = false -%}
                {%- if option.name == section.settings.swatch_option -%}{%- assign is_swatch = true -%}{%- endif -%}
                <fieldset class="gh-field" data-gh-option>
                  <legend class="gh-field__legend gh-mono"><span>{{ option.name }}</span><b data-gh-option-value="{{ option_index }}">{{ option.selected_value }}</b></legend>
                  <div class="{% if is_swatch %}gh-swatches{% else %}gh-chips{% endif %}">
                    {%- for value in option.values -%}
                      {%- assign input_id = 'gh-' | append: section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                      {%- if is_swatch -%}
                        {%- assign swatch_media = nil -%}
                        {%- for v in product.variants -%}
                          {%- if v.options[option_index] == value and v.featured_media -%}{%- assign swatch_media = v.featured_media -%}{%- break -%}{%- endif -%}
                        {%- endfor -%}
                        {%- assign t = forloop.index0 | modulo: tone_count -%}
                        <label class="gh-swatch" for="{{ input_id }}">
                          <input type="radio" id="{{ input_id }}" name="gh-opt-{{ section.id }}-{{ option_index }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                          <span class="gh-swatch__img gh-media" style="--tone: {{ tones[t] | strip }}">
                            {%- if swatch_media -%}
                              {{ swatch_media | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
                            {%- else -%}
                              <span class="gh-ph">{% render 'gnarhead-icon', name: 'mask' %}</span>
                            {%- endif -%}
                          </span>
                          <span class="gh-swatch__name">{{ value }}</span>
                        </label>
                      {%- else -%}
                        <label class="gh-chip" for="{{ input_id }}">
                          <input type="radio" id="{{ input_id }}" name="gh-opt-{{ section.id }}-{{ option_index }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                          <span>{{ value }}</span>
                        </label>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            {%- endunless -%}

            {%- if section.settings.show_bundles -%}
              <fieldset class="gh-field">
                <legend class="gh-field__legend gh-mono"><span>{{ section.settings.bundle_heading }}</span></legend>
                <div class="gh-bundles" data-gh-bundle>
                  {%- for i in (1..3) -%}
                    {%- capture k_label -%}bundle_{{ i }}_label{%- endcapture -%}
                    {%- capture k_note -%}bundle_{{ i }}_note{%- endcapture -%}
                    {%- capture k_pct -%}bundle_{{ i }}_pct{%- endcapture -%}
                    {%- capture k_tag -%}bundle_{{ i }}_tag{%- endcapture -%}
                    <div class="gh-bundle">
                      <input type="radio" name="gh-bundle-{{ section.id }}" value="{{ i }}" data-pct="{{ section.settings[k_pct] }}" aria-label="{{ section.settings[k_label] | escape }}" {% if i == section.settings.bundle_default %}checked{% endif %}>
                      <div class="gh-bundle__row">
                        <span class="gh-bundle__radio"></span>
                        <span>
                          <span class="gh-bundle__name">{{ section.settings[k_label] }}</span>
                          {%- if section.settings[k_tag] != blank -%}<span class="gh-bundle__tag gh-mono">{{ section.settings[k_tag] }}</span>{%- endif -%}
                          <span class="gh-bundle__note">{{ section.settings[k_note] }}</span>
                        </span>
                        <span class="gh-bundle__price"><span data-gh-bundle-now></span><s data-gh-bundle-was></s></span>
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endif -%}

            <button type="submit" name="add" class="gh-atc" data-gh-atc {% unless current_variant.available %}disabled{% endunless %}>
              <span data-gh-atc-label>{% if current_variant.available %}{{ section.settings.atc_label }}{% else %}Sold out{% endif %}</span>
              <span class="gh-atc__price" data-gh-price>{{ current_variant.price | money }}</span>
            </button>
            {%- if section.settings.ship_line != blank -%}
              <p class="gh-ship"><span class="gh-ship__dot"></span>{{ section.settings.ship_line }}</p>
            {%- endif -%}
            {{ form | payment_terms }}
          {%- endform -%}

          <div class="gh-perks">
            <div class="gh-perk">{% render 'gnarhead-icon', name: 'truck' %}<span>{{ section.settings.perk_1 }}</span></div>
            <div class="gh-perk">{% render 'gnarhead-icon', name: 'return' %}<span>{{ section.settings.perk_2 }}</span></div>
            <div class="gh-perk">{% render 'gnarhead-icon', name: 'lock' %}<span>{{ section.settings.perk_3 }}</span></div>
          </div>

          <div class="gh-acc">
            {%- if product.description != blank -%}
              <details open><summary class="gh-mono">Details</summary><div class="gh-acc__body">{{ product.description }}</div></details>
            {%- endif -%}
            {%- if section.settings.materials != blank -%}
              <details><summary class="gh-mono">Materials &amp; care</summary><div class="gh-acc__body">{{ section.settings.materials }}</div></details>
            {%- endif -%}
            {%- if section.settings.shipping != blank -%}
              <details><summary class="gh-mono">Shipping &amp; returns</summary><div class="gh-acc__body">{{ section.settings.shipping }}</div></details>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ================= MANIFESTO ================= {%- endcomment -%}
  {%- if section.settings.manifesto_1 != blank -%}
    <section class="gh-manifesto">
      <div class="gh-wrap">
        <p class="gh-kicker gh-mono">{{ section.settings.manifesto_kicker }}</p>
        <h2 class="gh-display">
          <span class="gh-manifesto__line" style="display:block">{{ section.settings.manifesto_1 }}</span>
          <span class="gh-manifesto__line gh-manifesto__line--indent" style="display:block">{{ section.settings.manifesto_2 }}</span>
        </h2>
        <div class="gh-manifesto__foot"><span class="gh-mono">{{ section.settings.manifesto_meta }}</span><p>{{ section.settings.manifesto_text }}</p></div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= THE CREW ================= {%- endcomment -%}
  {%- if chars.size > 0 -%}
    <section class="gh-section">
      <div class="gh-wrap gh-section__head">
        <div><p class="gh-kicker gh-mono">{{ section.settings.crew_kicker }}</p><h2 class="gh-h2 gh-display">{{ section.settings.crew_heading }}</h2></div>
        <p class="gh-muted">{{ section.settings.crew_text }}</p>
      </div>
      <div class="gh-crew">
        {%- for block in chars -%}
          {%- assign t = forloop.index0 | modulo: tone_count -%}
          <article class="gh-crew__item" {{ block.shopify_attributes }}>
            <div class="gh-crew__media gh-media" style="--tone: {{ tones[t] | strip }}">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1200px) 20vw, 72vw', alt: block.settings.name }}
              {%- else -%}
                <div class="gh-ph">{% render 'gnarhead-icon', name: 'mask' %}<span class="gh-ph__cap gh-mono">{{ block.settings.name }}</span></div>
              {%- endif -%}
            </div>
            <div class="gh-crew__body">
              <span class="gh-crew__idx gh-mono">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="gh-h3">{{ block.settings.name }}</h3>
              <p class="gh-crew__line">{{ block.settings.line }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= SPEC ================= {%- endcomment -%}
  {%- if specs.size > 0 or features.size > 0 -%}
    <section class="gh-section">
      <div class="gh-wrap gh-spec">
        <div class="gh-spec__media gh-media" style="--tone: {{ tones[0] | strip }}">
          {%- if section.settings.spec_image -%}
            {{ section.settings.spec_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.spec_heading }}
          {%- else -%}
            <div class="gh-ph">{% render 'gnarhead-icon', name: 'mask' %}<span class="gh-ph__cap gh-mono">Detail photo — knit close-up</span></div>
          {%- endif -%}
        </div>
        <div>
          <p class="gh-kicker gh-mono">{{ section.settings.spec_kicker }}</p>
          <h2 class="gh-h2 gh-display">{{ section.settings.spec_heading }}</h2>
          {%- if specs.size > 0 -%}
            <table class="gh-spec__table">
              <tbody>
                {%- for block in specs -%}
                  <tr {{ block.shopify_attributes }}><th scope="row" class="gh-mono">{{ block.settings.label }}</th><td>{{ block.settings.value }}</td></tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- endif -%}
          {%- if features.size > 0 -%}
            <div class="gh-features">
              {%- for block in features -%}
                <div class="gh-feature" {{ block.shopify_attributes }}>
                  {% render 'gnarhead-icon', name: block.settings.icon %}
                  <h3 class="gh-h3">{{ block.settings.title }}</h3>
                  <p>{{ block.settings.text }}</p>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FIELD FOOTAGE ================= {%- endcomment -%}
  {%- if videos.size > 0 -%}
    <section class="gh-section gh-field-footage">
      <div class="gh-wrap gh-section__head">
        <div><p class="gh-kicker gh-mono">{{ section.settings.reel_kicker }}</p><h2 class="gh-h2 gh-display">{{ section.settings.reel_heading }}</h2></div>
        <p class="gh-muted">{{ section.settings.reel_text }}</p>
      </div>
      <div class="gh-reel">
        {%- for block in videos -%}
          <figure class="gh-reel__item" {{ block.shopify_attributes }}>
            <div class="gh-reel__media gh-media">
              {%- if block.settings.video -%}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '540x' }}
              {%- elsif block.settings.poster -%}
                {{ block.settings.poster | image_url: width: 540 | image_tag: loading: 'lazy', alt: block.settings.caption }}
              {%- else -%}
                <div class="gh-ph">{% render 'gnarhead-icon', name: 'mask' %}<span class="gh-ph__cap gh-mono">Vertical video 9:16</span></div>
              {%- endif -%}
            </div>
            <figcaption class="gh-reel__cap"><span>{{ block.settings.caption }}</span><span class="gh-mono">{{ block.settings.tag }}</span></figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= REVIEWS (real customers only) ================= {%- endcomment -%}
  {%- if reviews.size > 0 -%}
    <section class="gh-section">
      <div class="gh-wrap">
        <div class="gh-section__head"><div><p class="gh-kicker gh-mono">Reviews</p><h2 class="gh-h2 gh-display">{{ section.settings.reviews_heading }}</h2></div></div>
        <div class="gh-reviews">
          {%- for block in reviews -%}
            <figure class="gh-review" {{ block.shopify_attributes }}>
              {% render 'gnarhead-icon', name: 'stars' %}
              <blockquote>“{{ block.settings.text }}”</blockquote>
              <figcaption class="gh-review__by gh-mono">{{ block.settings.name }} · Verified buyer</figcaption>
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= GUARANTEE ================= {%- endcomment -%}
  {%- if section.settings.guarantee_heading != blank -%}
    <section class="gh-section">
      <div class="gh-wrap gh-guarantee">
        <div class="gh-guarantee__num gh-display">{{ section.settings.guarantee_days }}</div>
        <div class="gh-guarantee__body">
          <p class="gh-kicker gh-mono">{{ section.settings.guarantee_kicker }}</p>
          <h2 class="gh-h2 gh-display">{{ section.settings.guarantee_heading }}</h2>
          <p class="gh-muted">{{ section.settings.guarantee_text }}</p>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FAQ ================= {%- endcomment -%}
  {%- if faqs.size > 0 -%}
    <section class="gh-section">
      <div class="gh-wrap gh-faq">
        <div><p class="gh-kicker gh-mono">FAQ</p><h2 class="gh-h2 gh-display">{{ section.settings.faq_heading }}</h2></div>
        <div class="gh-faq__list">
          {%- for block in faqs -%}
            <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="gh-faq__a">{{ block.settings.answer }}</div></details>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FINAL CTA ================= {%- endcomment -%}
  <section class="gh-final">
    <div class="gh-media">
      {%- if section.settings.final_image -%}
        {{ section.settings.final_image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', alt: '' }}
      {%- else -%}
        <div class="gh-ph">{% render 'gnarhead-icon', name: 'mask' %}<span class="gh-ph__cap gh-mono" style="color:var(--paper)">Wide group photo — 16:9</span></div>
      {%- endif -%}
    </div>
    <div class="gh-wrap gh-final__inner">
      <h2 class="gh-h2 gh-display">{{ section.settings.final_heading | newline_to_br }}</h2>
      <button type="button" class="gh-atc" data-gh-submit-main data-gh-atc>
        <span data-gh-atc-label>{{ section.settings.atc_label }}</span><span class="gh-atc__price" data-gh-price>{{ current_variant.price | money }}</span>
      </button>
    </div>
  </section>

  <div class="gh-sticky" data-gh-sticky>
    <div>
      <div class="gh-sticky__title">{{ product.title }}</div>
      <div class="gh-sticky__sub" data-gh-sticky-sub>{{ current_variant.title }}</div>
    </div>
    <button type="button" class="gh-atc" data-gh-submit-main data-gh-atc>
      <span data-gh-atc-label>{{ section.settings.atc_label }}</span><span class="gh-atc__price" data-gh-price>{{ current_variant.price | money }}</span>
    </button>
  </div>

  <script type="application/json" data-gh-json>
    {
      "moneyFormat": {{ shop.money_format | json }},
      "strings": {
        "addToCart": {{ section.settings.atc_label | json }},
        "soldOut": "Sold out",
        "unavailable": "Unavailable",
        "save": "Save [percent]%"
      },
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "title": {{ v.title | json }},
            "options": {{ v.options | json }},
            "price": {{ v.price }},
            "compare_at_price": {{ v.compare_at_price | default: 0 }},
            "available": {{ v.available }},
            "image": {% if v.featured_media %}{{ v.featured_media | image_url: width: 1800 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</div>

{% schema %}
{
  "name": "GNARHEAD landing",
  "tag": "section",
  "class": "gh-section-wrapper",
  "settings": [
    { "type": "text", "id": "placeholder_tones", "label": "Placeholder tones (comma separated)", "default": "#d8ccb8,#cdc6bd,#c9a27a,#dcc2a0,#a9b5a0", "info": "Background colours shown until photos are uploaded." },

    { "type": "header", "content": "Buy box" },
    { "type": "text", "id": "meta_left", "label": "Meta left", "default": "Balaclava — 001" },
    { "type": "text", "id": "meta_right", "label": "Meta right", "default": "Season 26/27" },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "A properly warm, goggle-ready ski balaclava — with a face nobody in the lift line will forget." },
    { "type": "text", "id": "swatch_option", "label": "Option shown as image swatches", "default": "Face" },
    { "type": "checkbox", "id": "show_bundles", "label": "Show bundle selector", "default": true },
    { "type": "text", "id": "bundle_heading", "label": "Bundle heading", "default": "Quantity" },
    { "type": "range", "id": "bundle_default", "label": "Pre-selected bundle", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "text", "id": "bundle_1_label", "label": "Bundle 1 label", "default": "One mask" },
    { "type": "text", "id": "bundle_1_note", "label": "Bundle 1 note", "default": "Standard shipping" },
    { "type": "range", "id": "bundle_1_pct", "label": "Bundle 1 discount %", "min": 0, "max": 50, "step": 1, "default": 0, "info": "Must match an automatic discount in Shopify → Discounts." },
    { "type": "text", "id": "bundle_1_tag", "label": "Bundle 1 tag" },
    { "type": "text", "id": "bundle_2_label", "label": "Bundle 2 label", "default": "Two masks" },
    { "type": "text", "id": "bundle_2_note", "label": "Bundle 2 note", "default": "Save 15% · Free shipping" },
    { "type": "range", "id": "bundle_2_pct", "label": "Bundle 2 discount %", "min": 0, "max": 50, "step": 1, "default": 15 },
    { "type": "text", "id": "bundle_2_tag", "label": "Bundle 2 tag", "default": "Popular" },
    { "type": "text", "id": "bundle_3_label", "label": "Bundle 3 label", "default": "Three masks" },
    { "type": "text", "id": "bundle_3_note", "label": "Bundle 3 note", "default": "Save 25% · Free shipping" },
    { "type": "range", "id": "bundle_3_pct", "label": "Bundle 3 discount %", "min": 0, "max": 50, "step": 1, "default": 25 },
    { "type": "text", "id": "bundle_3_tag", "label": "Bundle 3 tag" },
    { "type": "text", "id": "atc_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "ship_line", "label": "Line under button", "default": "In stock. Ships in 1–3 business days." },
    { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "Tracked shipping" },
    { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "30-day returns" },
    { "type": "text", "id": "perk_3", "label": "Perk 3", "default": "Secure checkout" },
    { "type": "richtext", "id": "materials", "label": "Materials & care", "default": "<p>Double-layer acrylic knit with a brushed fleece face panel. Hand wash cold, lay flat to dry. Do not tumble dry.</p>" },
    { "type": "richtext", "id": "shipping", "label": "Shipping & returns", "default": "<p>Ships in 1–3 business days with tracking. Delivery to the US, Canada and EU typically takes 6–12 business days. Returns accepted within 30 days of delivery on unworn items.</p>" },

    { "type": "header", "content": "Manifesto" },
    { "type": "text", "id": "manifesto_kicker", "label": "Kicker", "default": "The idea" },
    { "type": "text", "id": "manifesto_1", "label": "Line 1", "default": "Serious gear." },
