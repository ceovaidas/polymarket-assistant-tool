# Public URL of the app (used for Stripe redirects and the AI callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Kie.ai → API key (never commit the real key)
KIE_API_KEY=
# Random long string; the AI provider calls /api/kie/callback?token=<this>
KIE_CALLBACK_TOKEN=
