# Public URL of the app (used for Stripe redirects and the AI callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Kie.ai → API key (never commit the real key)
KIE_API_KEY=
# Random long string; the AI provider calls /api/kie/callback?token=<this>
KIE_CALLBACK_TOKEN=

# Lab (viral video → template → plan). Claude API key from console.anthropic.com (never commit the real key)
ANTHROPIC_API_KEY=
# The analysis worker (clipwright/worker) and the shared secret it expects
LAB_WORKER_URL=https://YOUR-WORKER.up.railway.app
LAB_WORKER_TOKEN=
# Comma-separated emails allowed to use the Lab (it spends your Claude budget)
LAB_OWNER_EMAILS=you@example.com
