{%- comment -%}
  GNARHEAD line icons. Usage: {% render 'jolly-icon', name: 'truck' %}
  'mask' is the placeholder silhouette shown until a real photo is uploaded.
{%- endcomment -%}
{%- case name -%}
  {%- when 'mask' -%}
    <svg viewBox="0 0 200 240" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M62 238c0-22-9-36-13-60-8-46-6-108 22-140 17-20 41-20 58 0 28 32 30 94 22 140-4 24-13 38-13 60"/><path d="M58 72c26-12 58-12 84 0"/><path d="M66 50c22-8 46-8 68 0" opacity=".5"/><rect x="46" y="92" width="108" height="42" rx="21" fill="currentColor" fill-opacity=".9"/><path d="M60 104c10-4 22-5 34-4" stroke="#fff" stroke-opacity=".55"/><path d="M40 113h6M154 113h6"/><ellipse cx="100" cy="168" rx="17" ry="10"/><path d="M58 210c28 6 56 6 84 0M60 222c27 6 53 6 80 0" opacity=".5"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h12v10H2zM14 9h4l4 4v3h-8z"/><circle cx="6.5" cy="17.5" r="1.8" fill="var(--paper,#fff)"/><circle cx="17.5" cy="17.5" r="1.8" fill="var(--paper,#fff)"/></svg>
  {%- when 'return' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M8 5 4 9l4 4"/></svg>
  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="10" width="16" height="11"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
  {%- when 'thermo' -%}
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 3v16"/><path d="m9 6 5 3 5-3M9 15l5-3 5 3"/><path d="M5 9.5 23 18.5M23 9.5 5 18.5" opacity=".45"/><path d="M14 19v6"/></svg>
  {%- when 'goggles' -%}
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="9" width="20" height="10" rx="5"/><path d="M1 14h3M24 14h3M8 12.5c1.5-.8 3-.9 4.5-.7"/></svg>
  {%- when 'breath' -%}
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 10h14a3 3 0 1 0-3-3M3 15h19a3 3 0 1 1-3 3M3 20h9"/></svg>
  {%- when 'helmet' -%}
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 18a10 10 0 0 1 20 0v2H4z"/><path d="M10 9.5c1 3 1 6 0 8.5M18 9.5c-1 3-1 6 0 8.5"/></svg>
  {%- when 'gift' -%}
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h18v12H5zM3 8h22v4H3zM14 8v16"/><path d="M14 8c-2-4-7-4-6-1s6 1 6 1 4-5 6-2-6 2-6 2"/></svg>
  {%- when 'wash' -%}
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8l2.5 14h17L25 8"/><path d="M5 12c2.5-1.5 4.5 1.5 7 0s4.5-1.5 7 0 3.5 1 4 .5"/></svg>
  {%- when 'stars' -%}
    <svg viewBox="0 0 76 12" fill="currentColor" aria-hidden="true">{%- for i in (0..4) -%}<path transform="translate({{ i | times: 16 }} 0)" d="M6 0l1.8 3.9 4.2.4-3.2 2.8.9 4.1L6 9.1 2.3 11.2l.9-4.1L0 4.3l4.2-.4z"/>{%- endfor -%}</svg>
  {%- when 'snow' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 2v20M3.3 7l17.4 10M3.3 17 20.7 7"/><path d="m9 3.5 3 2.5 3-2.5M9 20.5l3-2.5 3 2.5M3.6 10.6l3.7-1.3-.6-3.9M20.4 13.4l-3.7 1.3.6 3.9M3.6 13.4l3.7 1.3-.6 3.9M20.4 10.6l-3.7-1.3.6-3.9"/></svg>
  {%- when 'globe' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9c-2.5-2.6-3.7-5.6-3.7-9S9.5 5.6 12 3Z"/></svg>
  {%- when 'knit' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="m4 5 4 5 4-5 4 5 4-5M4 12l4 5 4-5 4 5 4-5"/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor" stroke="none" opacity=".14"/><path d="m7.5 12.5 3 3 6-6.5"/></svg>
  {%- when 'x' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor" stroke="none" opacity=".12"/><path d="m8.5 8.5 7 7M15.5 8.5l-7 7"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'chev-left' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
  {%- when 'chev-right' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
{%- endcase -%}
