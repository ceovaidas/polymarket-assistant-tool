{%- comment -%}
  Country/currency (and language, when more than one is published) picker.
  Usage: {% render 'jolly-localization', id: 'footer' %}
{%- endcomment -%}
{%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
  {%- assign loc_form_id = 'jh-loc-' | append: id -%}
  {%- form 'localization', id: loc_form_id, class: 'jh-loc' -%}
    {%- if localization.available_countries.size > 1 -%}
      <label class="jh-loc__field">
        <span class="visually-hidden">{{ 'jolly.loc.country' | t }}</span>
        {% render 'jolly-icon', name: 'globe' %}
        <select name="country_code" onchange="this.form.submit()" aria-label="{{ 'jolly.loc.country' | t }}">
          {%- for c in localization.available_countries -%}
            <option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }} {{ c.currency.symbol }})</option>
          {%- endfor -%}
        </select>
      </label>
    {%- endif -%}
    {%- if localization.available_languages.size > 1 -%}
      <label class="jh-loc__field">
        <span class="visually-hidden">{{ 'jolly.loc.language' | t }}</span>
        <select name="language_code" onchange="this.form.submit()" aria-label="{{ 'jolly.loc.language' | t }}">
          {%- for l in localization.available_languages -%}
            <option value="{{ l.iso_code }}" lang="{{ l.iso_code }}"{% if l.iso_code == localization.language.iso_code %} selected{% endif %}>{{ l.endonym_name | capitalize }}</option>
          {%- endfor -%}
        </select>
      </label>
    {%- endif -%}
    <noscript><button type="submit" class="jh-btn">{{ 'jolly.loc.update' | t }}</button></noscript>
  {%- endform -%}
{%- endif -%}
