{%- comment -%}
  Jolly Haul — collection page (Shop all + every category). Uses the same cards as the home page.
  Price links like ?filter.v.price.lte=20 (gift finder) are applied by Shopify automatically.
{%- endcomment -%}

{{ 'jolly.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jolly.js' | asset_url }}" defer></script>

{%- liquid
  assign tones = section.settings.tones | split: ','
  assign tone_count = tones.size
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign coll_title = collection.title
  if collection.handle == 'all'
    assign coll_title = 'jolly.common.all_gifts' | t
  endif
  assign chip_handles = section.settings.chips | remove: ' ' | split: ','
  assign clear_url = ''
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign clear_url = filter.url_to_remove
      endif
    endif
  endfor
-%}

<div class="jh">
  <section class="jh-collhead">
    <div class="jh-lights" aria-hidden="true"></div>
    <div class="jh-wrap">
      <nav class="jh-crumbs jh-crumbs--center" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'jolly.common.home' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ coll_title }}</span>
      </nav>
      <h1 class="jh-h2">{{ coll_title }}</h1>
      {%- if collection.description != blank -%}<div class="jh-sub">{{ collection.description }}</div>{%- endif -%}
    </div>
  </section>

  <section class="jh-section" style="padding-top:28px">
    <div class="jh-wrap">
      {%- if chip_handles.size > 0 -%}
        <nav class="jh-pills" aria-label="Shop by category">
          {%- for h in chip_handles -%}
            {%- if h == 'all' -%}
              <a class="jh-pill{% if collection.handle == 'all' %} is-on{% endif %}" href="{{ routes.all_products_collection_url }}"{% if collection.handle == 'all' %} aria-current="page"{% endif %}>{{ 'jolly.common.all_gifts' | t }}</a>
            {%- else -%}
              {%- assign c = collections[h] -%}
              {%- if c == blank or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
              <a class="jh-pill{% if collection.handle == c.handle %} is-on{% endif %}" href="{{ c.url }}"{% if collection.handle == c.handle %} aria-current="page"{% endif %}>{{ c.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
      {%- paginate collection.products by section.settings.per_page -%}
        <div class="jh-collbar">
          <p class="jh-collbar__count">
            {{ 'jolly.collection.count' | t: count: collection.products_count }}
            {%- if clear_url != blank %} · <a class="jh-chipfilter" href="{{ clear_url }}">{{ 'jolly.collection.price_filter' | t }} <span aria-hidden="true">✕</span><span class="visually-hidden">{{ 'jolly.collection.remove_filter' | t }}</span></a>{%- endif -%}
          </p>
          <div class="jh-sort">
            <label for="jh-sort-{{ section.id }}">{{ 'jolly.collection.sort' | t }}</label>
            <select id="jh-sort-{{ section.id }}" data-jh-sort>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </div>
        </div>

        {%- if collection.products.size > 0 -%}
          <div class="jh-grid">
            {%- for p in collection.products -%}
              {%- assign t = forloop.index0 | modulo: tone_count -%}
              {% render 'jolly-card', card_product: p, tone: tones[t] %}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="jh-empty">
            <h2>{{ 'jolly.collection.empty_title' | t }}</h2>
            <p>{{ 'jolly.collection.empty_text' | t }}</p>
            <a class="jh-btn jh-btn--pop" href="{{ routes.all_products_collection_url }}">{{ 'jolly.collection.shop_all' | t }}</a>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="jh-pages" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">{% render 'jolly-icon', name: 'chev-left' %}</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>
              {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">{% render 'jolly-icon', name: 'chev-right' %}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Jolly collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "chips", "label": "Category links (collection handles)", "default": "all,new-arrivals,trending,gifts-under-25,funny-masks,baby-kids,pets,cozy-travel,star-projectors,ugly-sweaters,lights-decor,stocking-stuffers", "info": "Comma-separated. Empty collections are hidden automatically." },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "text", "id": "tones", "label": "Card background tones", "default": "#e7f1ea,#fbe9df,#fff1d6,#f6e3e3,#eef0e4,#f3ead8" }
  ]
}
{% endschema %}
