{%- comment -%}
  Jolly Haul — collection page (Shop all + every category). Uses the same cards as the home page.
  Price links like ?filter.v.price.lte=20 (gift finder) are applied by Shopify automatically.
{%- endcomment -%}

{{ 'jolly.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jolly.js' | asset_url }}" defer></script>

{%- liquid
  assign tones = section.settings.tones | split: ','
  assign tone_count = tones.size
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign clear_url = ''
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign clear_url = filter.url_to_remove
      endif
    endif
  endfor
-%}

<div class="jh">
  <section class="jh-collhead">
    <div class="jh-lights" aria-hidden="true"></div>
    <div class="jh-wrap">
      <span class="jh-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="jh-h2">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="jh-sub">{{ collection.description }}</div>{%- endif -%}
    </div>
  </section>

  <section class="jh-section" style="padding-top:32px">
    <div class="jh-wrap">
      {%- paginate collection.products by section.settings.per_page -%}
        <div class="jh-collbar">
          <p class="jh-collbar__count">
            {{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}
            {%- if clear_url != blank %} · <a class="jh-chipfilter" href="{{ clear_url }}">Price filter <span aria-hidden="true">✕</span><span class="visually-hidden">Remove price filter</span></a>{%- endif -%}
          </p>
          <div class="jh-sort">
            <label for="jh-sort-{{ section.id }}">Sort</label>
            <select id="jh-sort-{{ section.id }}" data-jh-sort>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </div>
        </div>

        {%- if collection.products.size > 0 -%}
          <div class="jh-grid">
            {%- for p in collection.products -%}
              {%- assign t = forloop.index0 | modulo: tone_count -%}
              {% render 'jolly-card', card_product: p, tone: tones[t] %}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="jh-empty">
            <h2>Nothing here yet</h2>
            <p>Try another price range or browse everything.</p>
            <a class="jh-btn jh-btn--pop" href="{{ routes.all_products_collection_url }}">Shop all</a>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="jh-pages" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">{% render 'jolly-icon', name: 'chev-left' %}</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>
              {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">{% render 'jolly-icon', name: 'chev-right' %}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Jolly collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Jolly Haul finds" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "text", "id": "tones", "label": "Card background tones", "default": "#e7f1ea,#fbe9df,#fff1d6,#f6e3e3,#eef0e4,#f3ead8" }
  ]
}
{% endschema %}
