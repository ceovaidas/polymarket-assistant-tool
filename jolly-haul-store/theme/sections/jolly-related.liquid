{%- comment -%}
  Jolly Haul — "You may also like". Use on product pages (source: product) and the cart (source: cart).
  Renders a fallback collection right away (excluding what the shopper is already looking at), then
  swaps in Shopify's product recommendations once the store has enough data to return some.
{%- endcomment -%}

{{ 'jolly.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jolly.js' | asset_url }}" defer></script>

{%- liquid
  assign tones = section.settings.tones | split: ','
  assign tone_count = tones.size
  assign limit = section.settings.limit
  assign pid = product.id
  assign exclude = '|'
  if section.settings.source == 'cart' and cart.item_count > 0
    assign pid = cart.items.first.product_id
    for item in cart.items
      assign exclude = exclude | append: item.product_id | append: '|'
    endfor
  elsif pid
    assign exclude = exclude | append: pid | append: '|'
  endif

  assign list = nil
  assign from_recs = false
  if recommendations.performed? and recommendations.products_count > 0
    assign list = recommendations.products
    assign from_recs = true
  else
    assign list = collections[section.settings.fallback].products
  endif

  assign shown = 0
  for p in list
    assign key = '|' | append: p.id | append: '|'
    unless exclude contains key
      assign shown = shown | plus: 1
    endunless
  endfor
-%}

{%- if shown > 0 or pid -%}
  <div class="jh jh-related"
    data-jh-related
    {% if pid and from_recs == false %}data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ pid }}&limit={{ limit | plus: 2 }}&intent={{ section.settings.intent }}"{% endif %}
    {% if shown == 0 %}hidden{% endif %}>
    <section class="jh-section{% if section.settings.cream %} jh-section--ice{% endif %}">
      <div class="jh-wrap">
        <div class="jh-grid-head">
          <div>
            <span class="jh-eyebrow">{{ section.settings.eyebrow }}</span>
            <h2 class="jh-h2">{{ section.settings.heading }}</h2>
          </div>
          <a class="jh-link" href="{{ routes.all_products_collection_url }}">{{ 'jolly.common.all_gifts' | t }} {% render 'jolly-icon', name: 'chev-right' %}</a>
        </div>
        <div class="jh-grid" data-jh-related-grid>
          {%- assign n = 0 -%}
          {%- for p in list -%}
            {%- assign key = '|' | append: p.id | append: '|' -%}
            {%- if exclude contains key -%}{%- continue -%}{%- endif -%}
            {%- if n >= limit -%}{%- break -%}{%- endif -%}
            {%- assign t = n | modulo: tone_count -%}
            {% render 'jolly-card', card_product: p, tone: tones[t] %}
            {%- assign n = n | plus: 1 -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Jolly recommendations",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "source", "label": "Recommend for", "default": "product", "options": [
      { "value": "product", "label": "The product on this page" }, { "value": "cart", "label": "Items in the cart" } ] },
    { "type": "select", "id": "intent", "label": "Type", "default": "related", "options": [
      { "value": "related", "label": "Similar products" }, { "value": "complementary", "label": "Goes well with (set in Search & Discovery)" } ] },
    { "type": "collection", "id": "fallback", "label": "Fallback collection", "info": "Shown until Shopify has enough data for recommendations." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete the haul" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "checkbox", "id": "cream", "label": "Cream background", "default": true },
    { "type": "text", "id": "tones", "label": "Card background tones", "default": "#e7f1ea,#fbe9df,#fff1d6,#f6e3e3" }
  ],
  "presets": [{ "name": "Jolly recommendations" }]
}
{% endschema %}
