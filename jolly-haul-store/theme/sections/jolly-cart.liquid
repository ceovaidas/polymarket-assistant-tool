{%- comment -%}
  Jolly Haul — cart page. Replaces Dawn's cart sections (templates/cart.json).
  Works without JavaScript: quantities post to /cart, "Check out" posts with name="checkout".
  With JavaScript, quantity changes submit automatically.
{%- endcomment -%}

{{ 'jolly.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jolly.js' | asset_url }}" defer></script>

{%- liquid
  assign tones = section.settings.tones | split: ','
  assign tone_count = tones.size
  assign threshold = section.settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  endif
-%}

<div class="jh" data-jh-cart>
  <section class="jh-collhead jh-carthead">
    <div class="jh-lights" aria-hidden="true"></div>
    <div class="jh-wrap">
      <span class="jh-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="jh-h2">{{ section.settings.heading }}</h1>
      {%- if cart.item_count > 0 -%}<p class="jh-sub">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %} · <a class="jh-link" href="{{ routes.all_products_collection_url }}">Continue shopping</a></p>{%- endif -%}
    </div>
  </section>

  <section class="jh-section" style="padding-top:32px">
    <div class="jh-wrap">
      {%- if cart.item_count == 0 -%}
        <div class="jh-empty jh-cart-empty">
          <div class="jh-cart-empty__art" aria-hidden="true">{% render 'jolly-art', face: 'gift' %}</div>
          <h2>Your haul is empty</h2>
          <p>Let's fix that — the internet's favourite Christmas finds are one click away.</p>
          <a class="jh-btn jh-btn--pop" href="{{ routes.all_products_collection_url }}">Shop the haul</a>
        </div>
      {%- else -%}
        <form action="{{ routes.cart_url }}" method="post" class="jh-cart" id="jh-cart-form" data-jh-cart-form novalidate>
          <div class="jh-cart__items">
            {%- for item in cart.items -%}
              {%- liquid
                assign t = forloop.index0 | modulo: tone_count
                assign art = 'gift'
                for tag in item.product.tags
                  if tag contains 'art-'
                    assign art = tag | remove_first: 'art-'
                  endif
                endfor
              -%}
              <article class="jh-line">
                <a class="jh-line__media jh-media" href="{{ item.url }}" style="--tone: {{ tones[t] | strip }}" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    <span class="jh-ph">{% render 'jolly-art', face: art %}</span>
                  {%- endif -%}
                </a>
                <div class="jh-line__info">
                  <a class="jh-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}<p class="jh-line__meta">{{ item.variant.title }}</p>{%- endunless -%}
                  {%- for p in item.properties -%}
                    {%- assign first = p.first | slice: 0 -%}
                    {%- if p.last != blank and first != '_' -%}<p class="jh-line__meta">{{ p.first }}: {{ p.last }}</p>{%- endif -%}
                  {%- endfor -%}
                  {%- for d in item.line_level_discount_allocations -%}
                    <p class="jh-line__disc">{% render 'jolly-icon', name: 'gift' %}{{ d.discount_application.title }} (−{{ d.amount | money }})</p>
                  {%- endfor -%}
                  <div class="jh-line__row">
                    <div class="jh-qty">
                      <button type="button" class="jh-qty__btn" data-jh-step="-1" aria-label="Decrease quantity of {{ item.product.title | escape }}">−</button>
                      <label class="visually-hidden" for="jh-qty-{{ item.index }}">Quantity of {{ item.product.title | escape }}</label>
                      <input id="jh-qty-{{ item.index }}" class="jh-qty__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" data-jh-qty-input>
                      <button type="button" class="jh-qty__btn" data-jh-step="1" aria-label="Increase quantity of {{ item.product.title | escape }}">+</button>
                    </div>
                    <a class="jh-line__remove" href="{{ item.url_to_remove }}">Remove</a>
                  </div>
                </div>
                <div class="jh-line__price">
                  {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                  <span>{{ item.final_line_price | money }}</span>
                </div>
              </article>
            {%- endfor -%}
            <button type="submit" name="update" class="jh-btn jh-cart__update" data-jh-cart-update>Update cart</button>
          </div>

          <aside class="jh-summary" aria-label="Order summary">
            {%- liquid
              assign mix_next = nil
              assign mix_now = 0
              assign mix_tiers = section.settings.mix_tiers | remove: ' ' | split: ','
              for tier in mix_tiers
                assign parts = tier | split: ':'
                assign tq = parts[0] | plus: 0
                assign tp = parts[1] | plus: 0
                if cart.item_count >= tq
                  assign mix_now = tp
                elsif mix_next == nil
                  assign mix_next = tq
                  assign mix_next_pct = tp
                endif
              endfor
            -%}
            {%- if mix_tiers.size > 0 and section.settings.mix_tiers != blank -%}
              <div class="jh-mix">
                {% render 'jolly-icon', name: 'gift' %}
                <p>
                  {%- if mix_next -%}
                    {%- assign need = mix_next | minus: cart.item_count -%}
                    {%- if mix_now > 0 %}<b>Gift discount applied.</b> {% endif -%}
                    Add {{ need }} more {% if need == 1 %}gift{% else %}gifts{% endif %} to save <b>{{ mix_next_pct }}%</b>
                  {%- else -%}
                    <b>Mix &amp; match discount applied</b> · best deal picked at checkout
                  {%- endif -%}
                </p>
              </div>
            {%- endif -%}
            {%- if threshold > 0 -%}
              <div class="jh-ship">
                {%- if remaining > 0 -%}
                  <p>You're <b>{{ remaining | money }}</b> away from free shipping</p>
                {%- else -%}
                  <p><b>You've unlocked free shipping!</b></p>
                {%- endif -%}
                <div class="jh-ship__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}" aria-label="Progress to free shipping"><span style="width: {{ progress }}%"></span></div>
              </div>
            {%- endif -%}

            <div class="jh-summary__rows">
              {%- if cart.cart_level_discount_applications.size > 0 -%}
                <div class="jh-summary__row"><span>Items</span><span>{{ cart.items_subtotal_price | money }}</span></div>
                {%- for d in cart.cart_level_discount_applications -%}
                  <div class="jh-summary__row jh-summary__row--disc"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>
                {%- endfor -%}
              {%- endif -%}
              <div class="jh-summary__row jh-summary__row--total"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
              <p class="jh-summary__note">Shipping and taxes are calculated at checkout.</p>
            </div>

            <div class="jh-wincode" data-jh-wincode hidden>
              {% render 'jolly-icon', name: 'gift' %}
              <p>Your wheel prize <b data-jh-wincode-code></b> — <a href="#" data-jh-wincode-link>apply it at checkout</a></p>
            </div>

            {%- if section.settings.show_note -%}
              <details class="jh-giftnote"{% if cart.note != blank %} open{% endif %}>
                <summary>{% render 'jolly-icon', name: 'gift' %}Add a gift note</summary>
                <label class="visually-hidden" for="jh-cart-note">Gift note</label>
                <textarea id="jh-cart-note" name="note" rows="3" maxlength="250" placeholder="Merry Christmas! Love, …">{{ cart.note }}</textarea>
                <p class="jh-summary__note">We leave prices out of the parcel.</p>
              </details>
            {%- endif -%}

            <button type="submit" name="checkout" class="jh-btn jh-btn--pop jh-summary__checkout">
              {% render 'jolly-icon', name: 'lock' %}Check out
            </button>
            {%- if additional_checkout_buttons and section.settings.show_express -%}
              <div class="jh-summary__express">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}

            <ul class="jh-summary__trust">
              <li>{% render 'jolly-icon', name: 'truck' %}Ships in 1–3 days</li>
              <li>{% render 'jolly-icon', name: 'return' %}30-day returns</li>
              <li>{% render 'jolly-icon', name: 'lock' %}Secure checkout</li>
            </ul>
          </aside>
        </form>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Jolly cart",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Almost there" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your haul" },
    { "type": "text", "id": "mix_tiers", "label": "Mix & match tiers (items:percent)", "default": "2:10,3:15", "info": "Must match your automatic discounts in Shopify. Leave empty to hide." },
    { "type": "range", "id": "free_shipping_threshold", "label": "Free shipping from", "min": 0, "max": 200, "step": 5, "unit": "$", "default": 50, "info": "Set 0 to hide the progress bar. Must match your shipping rates." },
    { "type": "checkbox", "id": "show_note", "label": "Show gift note", "default": true },
    { "type": "checkbox", "id": "show_express", "label": "Show express checkout buttons (Shop Pay, Apple Pay…)", "default": true },
    { "type": "text", "id": "tones", "label": "Image background tones", "default": "#e7f1ea,#fbe9df,#fff1d6,#f6e3e3,#eef0e4,#f3ead8" }
  ]
}
{% endschema %}
