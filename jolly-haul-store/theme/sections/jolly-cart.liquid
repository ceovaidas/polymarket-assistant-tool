{%- comment -%}
  Jolly Haul — cart page. Replaces Dawn's cart sections (templates/cart.json).
  Works without JavaScript: quantities post to /cart, "Check out" posts with name="checkout".
  With JavaScript, quantity changes submit automatically.
{%- endcomment -%}

{{ 'jolly.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jolly.js' | asset_url }}" defer></script>

{%- liquid
  assign tones = section.settings.tones | split: ','
  assign tone_count = tones.size
  assign threshold = section.settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  endif

  # Free-shipping helpers: cheapest products that close the gap on their own, else the closest ones below it.
  assign ship_picks = ''
  if threshold > 0 and remaining > 0 and cart.item_count > 0 and section.settings.ship_upsell_count > 0
    assign in_cart = cart.items | map: 'product_id' | join: ','
    assign in_cart = ',' | append: in_cart | append: ','
    assign pool = section.settings.ship_upsell_collection.products
    if pool == blank or pool.size == 0
      assign pool = collections['stocking-stuffers'].products
    endif
    if pool == blank or pool.size == 0
      assign pool = collections.all.products
    endif
    assign pool = pool | sort: 'price'
    assign covers = ''
    assign below = ''
    for p in pool limit: 50
      assign key = ',' | append: p.id | append: ','
      if p.available == false or in_cart contains key or p.gift_card?
        continue
      endif
      if p.price >= remaining
        assign covers = covers | append: p.handle | append: ' '
      else
        assign below = p.handle | append: ' ' | append: below
      endif
    endfor
    assign ship_picks = covers | append: below | strip | split: ' '
  endif
-%}

<div class="jh" data-jh-cart>
  <section class="jh-collhead jh-carthead">
    <div class="jh-lights" aria-hidden="true"></div>
    <div class="jh-wrap">
      <span class="jh-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="jh-h2">{{ section.settings.heading }}</h1>
      {%- if cart.item_count > 0 -%}<p class="jh-sub">{{ 'jolly.cart.count' | t: count: cart.item_count }} · <a class="jh-link" href="{{ routes.all_products_collection_url }}">{{ 'jolly.cart.continue' | t }}</a></p>{%- endif -%}
    </div>
  </section>

  <section class="jh-section" style="padding-top:32px">
    <div class="jh-wrap">
      {%- if cart.item_count == 0 -%}
        <div class="jh-empty jh-cart-empty">
          <div class="jh-cart-empty__art" aria-hidden="true">{% render 'jolly-art', face: 'gift' %}</div>
          <h2>{{ 'jolly.cart.empty_title' | t }}</h2>
          <p>{{ 'jolly.cart.empty_text' | t }}</p>
          <a class="jh-btn jh-btn--pop" href="{{ routes.all_products_collection_url }}">{{ 'jolly.cart.empty_button' | t }}</a>
        </div>
      {%- else -%}
        <form action="{{ routes.cart_url }}" method="post" class="jh-cart" id="jh-cart-form" data-jh-cart-form novalidate>
          <div class="jh-cart__items">
            {%- for item in cart.items -%}
              {%- liquid
                assign t = forloop.index0 | modulo: tone_count
                assign art = 'gift'
                for tag in item.product.tags
                  if tag contains 'art-'
                    assign art = tag | remove_first: 'art-'
                  endif
                endfor
              -%}
              <article class="jh-line">
                <a class="jh-line__media jh-media" href="{{ item.url }}" style="--tone: {{ tones[t] | strip }}" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    <span class="jh-ph">{% render 'jolly-art', face: art %}</span>
                  {%- endif -%}
                </a>
                <div class="jh-line__info">
                  <a class="jh-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}<p class="jh-line__meta">{{ item.variant.title }}</p>{%- endunless -%}
                  {%- for p in item.properties -%}
                    {%- assign first = p.first | slice: 0 -%}
                    {%- if p.last != blank and first != '_' -%}<p class="jh-line__meta">{{ p.first }}: {{ p.last }}</p>{%- endif -%}
                  {%- endfor -%}
                  {%- for d in item.line_level_discount_allocations -%}
                    <p class="jh-line__disc">{% render 'jolly-icon', name: 'gift' %}{{ d.discount_application.title }} (−{{ d.amount | money }})</p>
                  {%- endfor -%}
                  <div class="jh-line__row">
                    <div class="jh-qty">
                      <button type="button" class="jh-qty__btn" data-jh-step="-1" aria-label="Decrease quantity of {{ item.product.title | escape }}">−</button>
                      <label class="visually-hidden" for="jh-qty-{{ item.index }}">Quantity of {{ item.product.title | escape }}</label>
                      <input id="jh-qty-{{ item.index }}" class="jh-qty__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" data-jh-qty-input>
                      <button type="button" class="jh-qty__btn" data-jh-step="1" aria-label="Increase quantity of {{ item.product.title | escape }}">+</button>
                    </div>
                    <a class="jh-line__remove" href="{{ item.url_to_remove }}">{{ 'jolly.cart.remove' | t }}</a>
                  </div>
                </div>
                <div class="jh-line__price">
                  {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                  <span>{{ item.final_line_price | money }}</span>
                </div>
              </article>
            {%- endfor -%}
            <button type="submit" name="update" class="jh-btn jh-cart__update" data-jh-cart-update>{{ 'jolly.cart.update' | t }}</button>
          </div>

          <aside class="jh-summary" aria-label="Order summary">
            {%- liquid
              assign mix_next = nil
              assign mix_now = 0
              assign mix_tiers = section.settings.mix_tiers | remove: ' ' | split: ','
              for tier in mix_tiers
                assign parts = tier | split: ':'
                assign tq = parts[0] | plus: 0
                assign tp = parts[1] | plus: 0
                if cart.item_count >= tq
                  assign mix_now = tp
                elsif mix_next == nil
                  assign mix_next = tq
                  assign mix_next_pct = tp
                endif
              endfor
            -%}
            {%- if mix_tiers.size > 0 and section.settings.mix_tiers != blank -%}
              <div class="jh-mix">
                {% render 'jolly-icon', name: 'gift' %}
                <p>
                  {%- if mix_next -%}
                    {%- assign need = mix_next | minus: cart.item_count -%}
                    {%- if mix_now > 0 %}<b>{{ 'jolly.cart.mix_applied' | t }}</b> {% endif -%}
                    {{ 'jolly.cart.mix_more_html' | t: count: need, pct: mix_next_pct }}
                  {%- else -%}
                    {{ 'jolly.cart.mix_done_html' | t }}
                  {%- endif -%}
                </p>
              </div>
            {%- endif -%}
            {%- if threshold > 0 -%}
              <div class="jh-ship">
                {%- if remaining > 0 -%}
                  {%- assign remaining_money = remaining | money -%}
                  <p>{{ 'jolly.cart.ship_away_html' | t: amount: remaining_money }}</p>
                {%- else -%}
                  <p><b>{{ 'jolly.cart.ship_done' | t }}</b></p>
                {%- endif -%}
                <div class="jh-ship__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}" aria-label="Progress to free shipping"><span style="width: {{ progress }}%"></span></div>
                {%- if ship_picks.size > 0 -%}
                  <div class="jh-shipup">
                    <p class="jh-shipup__title">{{ 'jolly.cart.ship_upsell_title' | t }}</p>
                    <ul class="jh-shipup__list">
                      {%- for h in ship_picks limit: section.settings.ship_upsell_count -%}
                        {%- assign p = all_products[h] -%}
                        {%- assign v = p.selected_or_first_available_variant -%}
                        <li class="jh-shipup__item">
                          <a class="jh-shipup__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
                            {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
                          </a>
                          <div class="jh-shipup__info">
                            <a class="jh-shipup__name" href="{{ p.url }}">{{ p.title }}</a>
                            <span class="jh-shipup__price">{{ p.price | money }}{% if p.price >= remaining %} · <b>{{ 'jolly.cart.ship_upsell_unlocks' | t }}</b>{% endif %}</span>
                          </div>
                          {%- if p.has_only_default_variant or p.variants.size == 1 -%}
                            <button type="submit" form="jh-shipup-{{ v.id }}" class="jh-shipup__add" aria-label="{{ 'jolly.cart.ship_upsell_add' | t }}: {{ p.title | escape }}">{% render 'jolly-icon', name: 'plus' %}<span>{{ 'jolly.cart.ship_upsell_add' | t }}</span></button>
                          {%- else -%}
                            <a class="jh-shipup__add jh-shipup__add--link" href="{{ p.url }}">{{ 'jolly.cart.ship_upsell_choose' | t }}</a>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="jh-summary__rows">
              {%- if cart.cart_level_discount_applications.size > 0 -%}
                <div class="jh-summary__row"><span>{{ 'jolly.cart.items_label' | t }}</span><span>{{ cart.items_subtotal_price | money }}</span></div>
                {%- for d in cart.cart_level_discount_applications -%}
                  <div class="jh-summary__row jh-summary__row--disc"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>
                {%- endfor -%}
              {%- endif -%}
              {%- if cart.total_discount > 0 -%}
                <div class="jh-summary__row jh-summary__row--disc"><span>{{ 'jolly.cart.savings' | t }}</span><span>−{{ cart.total_discount | money }}</span></div>
              {%- endif -%}
              <div class="jh-summary__row jh-summary__row--total"><span>{{ 'jolly.cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
              <p class="jh-summary__note">{{ 'jolly.cart.taxes_note' | t }}</p>
            </div>

            <div class="jh-wincode" data-jh-wincode hidden>
              {% render 'jolly-icon', name: 'gift' %}
              <p>{{ 'jolly.cart.wheel_prize' | t }} <b data-jh-wincode-code></b> — <a href="#" data-jh-wincode-link>{{ 'jolly.cart.wheel_apply' | t }}</a></p>
            </div>

            {%- if section.settings.show_note -%}
              <details class="jh-giftnote"{% if cart.note != blank %} open{% endif %}>
                <summary>{% render 'jolly-icon', name: 'gift' %}{{ 'jolly.cart.note_add' | t }}</summary>
                <label class="visually-hidden" for="jh-cart-note">{{ 'jolly.cart.note_label' | t }}</label>
                <textarea id="jh-cart-note" name="note" rows="3" maxlength="250" placeholder="{{ 'jolly.cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
                <p class="jh-summary__note">{{ 'jolly.cart.note_hint' | t }}</p>
              </details>
            {%- endif -%}

            <button type="submit" name="checkout" class="jh-btn jh-btn--pop jh-summary__checkout">
              {% render 'jolly-icon', name: 'lock' %}{{ 'jolly.cart.checkout' | t }}
            </button>
            {%- if additional_checkout_buttons and section.settings.show_express -%}
              <div class="jh-summary__express">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}

            <ul class="jh-summary__trust">
              <li>{% render 'jolly-icon', name: 'truck' %}{{ 'jolly.cart.trust_ship' | t }}</li>
              <li>{% render 'jolly-icon', name: 'return' %}{{ 'jolly.cart.trust_returns' | t }}</li>
              <li>{% render 'jolly-icon', name: 'lock' %}{{ 'jolly.cart.trust_secure' | t }}</li>
            </ul>
          </aside>
        </form>
        {%- for h in ship_picks limit: section.settings.ship_upsell_count -%}
          {%- assign p = all_products[h] -%}
          {%- if p.has_only_default_variant or p.variants.size == 1 -%}
            <form id="jh-shipup-{{ p.selected_or_first_available_variant.id }}" action="{{ routes.cart_add_url }}" method="post" hidden>
              <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
            </form>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Jolly cart",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Almost there" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your haul" },
    { "type": "text", "id": "mix_tiers", "label": "Mix & match tiers (items:percent)", "default": "2:10,3:15", "info": "Must match your automatic discounts in Shopify. Leave empty to hide." },
    { "type": "range", "id": "free_shipping_threshold", "label": "Free shipping from", "min": 0, "max": 200, "step": 5, "unit": "$", "default": 50, "info": "Set 0 to hide the progress bar. Must match your shipping rates." },
    { "type": "range", "id": "ship_upsell_count", "label": "Free-shipping suggestions", "min": 0, "max": 3, "step": 1, "default": 2, "info": "Products shown under the progress bar that close the gap. 0 hides them." },
    { "type": "collection", "id": "ship_upsell_collection", "label": "Suggest products from", "info": "Defaults to Stocking stuffers. Products already in the cart are skipped." },
    { "type": "checkbox", "id": "show_note", "label": "Show gift note", "default": true },
    { "type": "checkbox", "id": "show_express", "label": "Show express checkout buttons (Shop Pay, Apple Pay…)", "default": true },
    { "type": "text", "id": "tones", "label": "Image background tones", "default": "#e7f1ea,#fbe9df,#fff1d6,#f6e3e3,#eef0e4,#f3ead8" }
  ]
}
{% endschema %}
