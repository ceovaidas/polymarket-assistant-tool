    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "FAQ heading",
      "default": "Before you check out"
    },
    {
      "type": "text",
      "id": "news_heading",
      "label": "Newsletter heading",
      "default": "Get first dibs on the next viral drop"
    },
    {
      "type": "textarea",
