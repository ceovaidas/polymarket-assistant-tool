          "label": "Custom link (optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (1:1)"
        },
        {
          "type": "select",
          "id": "art",
          "label": "Illustration (until image is set)",
          "default": "gramps",
          "options": [
            {
              "value": "gramps",
              "label": "Gramps mask"
