          "default": "Under"
        },
        {
          "type": "text",
          "id": "amount",
          "label": "Amount",
          "default": "$25"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Stocking stuffers"
        },
        {
          "type": "url",
