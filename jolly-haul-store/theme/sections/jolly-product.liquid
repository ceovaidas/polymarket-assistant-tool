{%- comment -%}
  GNARHEAD — one-product landing section ("Glacier Pop").
  Works in any Online Store 2.0 theme (Dawn recommended). Assign the "product.landing"
  template to the ski mask product. Requires snippets/gnarhead-icon.liquid and snippets/gnarhead-art.liquid.
{%- endcomment -%}

{{ 'gnarhead-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gnarhead-landing.js' | asset_url }}" defer></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count
  assign tones = section.settings.placeholder_tones | split: ','
  assign tone_count = tones.size
  assign art_keys = section.settings.art_order | split: ','
  assign art_count = art_keys.size
  assign has_footage = false
  for b in section.blocks
    if b.type == 'video'
      if b.settings.video != blank or b.settings.poster != blank
        assign has_footage = true
      endif
    endif
  endfor
  assign chars = section.blocks | where: 'type', 'character'
  assign specs = section.blocks | where: 'type', 'spec'
  assign features = section.blocks | where: 'type', 'feature'
  assign videos = section.blocks | where: 'type', 'video'
  assign reviews = section.blocks | where: 'type', 'review'
  assign faqs = section.blocks | where: 'type', 'faq'
  assign compares = section.blocks | where: 'type', 'compare'
  assign slide_count = product.media.size
  if slide_count == 0
    assign slide_count = art_count
  endif
-%}

<div class="gh" data-gh-root id="gh-{{ section.id }}">

  {%- if section.settings.ticker != blank -%}
    {%- assign ticker_items = section.settings.ticker | split: '|' -%}
    <div class="gh-ticker" role="region" aria-label="{{ section.settings.ticker | replace: '|', ' · ' | escape }}">
      <div class="gh-ticker__track" aria-hidden="true">
        {%- for i in (1..4) -%}{%- for item in ticker_items -%}<span>{{ item | strip }}</span>{%- endfor -%}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ================= PRODUCT ================= {%- endcomment -%}
  <section class="gh-product">
    <div class="gh-wrap gh-product__grid">

      <div class="gh-gallery">
        <div class="gh-gallery__frame">
          <div class="gh-gallery__track" data-gh-track>
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <figure class="gh-gallery__item gh-media" data-media-id="{{ media.id }}" {% if forloop.first %}data-gh-hero{% endif %}>
                  {%- if media.media_type == 'image' -%}
                    {%- if forloop.first -%}
                      {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                    {%- else -%}
                      {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                    {%- endif -%}
                  {%- elsif media.media_type == 'video' -%}
                    {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}
                  {%- else -%}
                    {{ media | media_tag }}
                  {%- endif -%}
                </figure>
              {%- endfor -%}
            {%- else -%}
              {%- for key in art_keys -%}
                {%- assign t = forloop.index0 | modulo: tone_count -%}
                <figure class="gh-gallery__item gh-media" style="--tone: {{ tones[t] | strip }}" {% if forloop.first %}data-gh-hero{% endif %}>
                  <div class="gh-ph">{% render 'gnarhead-art', face: key %}{% if request.design_mode %}<span class="gh-ph__cap">Upload photos in Products</span>{% endif %}</div>
                </figure>
              {%- endfor -%}
            {%- endif -%}
          </div>

          <div class="gh-perks-overlay" aria-hidden="true">
            {%- for i in (1..4) -%}
              {%- capture k_label -%}perk_{{ i }}_label{%- endcapture -%}
              {%- capture k_icon -%}perk_{{ i }}_icon{%- endcapture -%}
              {%- if section.settings[k_label] != blank -%}
                <div class="gh-perk-chip">{% render 'gnarhead-icon', name: section.settings[k_icon] %}{{ section.settings[k_label] }}</div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if slide_count > 1 -%}
            <button type="button" class="gh-gallery__nav gh-gallery__nav--prev" data-gh-prev aria-label="Previous image">{% render 'gnarhead-icon', name: 'chev-left' %}</button>
            <button type="button" class="gh-gallery__nav gh-gallery__nav--next" data-gh-next aria-label="Next image">{% render 'gnarhead-icon', name: 'chev-right' %}</button>
            <div class="gh-dots" data-gh-dots>
              {%- for i in (1..slide_count) -%}
                <button type="button" aria-label="Image {{ i }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- if slide_count > 1 -%}
          <div class="gh-thumbs" data-gh-thumbs>
            {%- if product.media.size > 0 -%}
              {%- for media in product.media limit: 6 -%}
                <button type="button" class="gh-thumb gh-media" aria-label="Show image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              {%- endfor -%}
            {%- else -%}
              {%- for key in art_keys limit: 6 -%}
                {%- assign t = forloop.index0 | modulo: tone_count -%}
                <button type="button" class="gh-thumb gh-media" style="--tone: {{ tones[t] | strip }}" aria-label="Show image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                  <span class="gh-ph">{% render 'gnarhead-art', face: key %}</span>
                </button>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="gh-buy">
        <div class="gh-buy__top">
          {%- if rating != blank -%}
            <span class="gh-rating">{% render 'gnarhead-icon', name: 'stars' %}{{ rating.rating | round: 1 }} · {{ rating_count }} reviews</span>
          {%- elsif section.settings.badge != blank -%}
            <span class="gh-pill">{% render 'gnarhead-icon', name: 'snow' %}{{ section.settings.badge }}</span>
          {%- endif -%}
        </div>

        <h1 class="gh-buy__title">{{ product.title }}</h1>
        {%- if section.settings.lede != blank -%}<p class="gh-buy__lede">{{ section.settings.lede }}</p>{%- endif -%}

        <div class="gh-price">
          <span class="gh-price__now" data-gh-price>{{ current_variant.price | money }}</span>
          <s class="gh-price__was" data-gh-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
          <span class="gh-price__save" data-gh-save hidden></span>
        </div>

        {%- if section.settings.hook != blank -%}
          <div class="gh-hook"><span class="gh-hook__emoji" aria-hidden="true">{{ section.settings.hook_emoji }}</span><span>{{ section.settings.hook }}</span></div>
        {%- endif -%}

        {%- assign gh_form_id = 'gh-form-' | append: section.id -%}
        {%- form 'product', product, id: gh_form_id, data-gh-form: 'true' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-gh-variant-id>
          <input type="hidden" name="quantity" value="1" data-gh-qty>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_index = forloop.index0 -%}
              {%- assign is_swatch = false -%}
              {%- if option.name == section.settings.swatch_option -%}{%- assign is_swatch = true -%}{%- endif -%}
              <fieldset class="gh-field" data-gh-option>
                <legend class="gh-field__legend">{{ option.name }}: <span data-gh-option-value="{{ option_index }}">{{ option.selected_value }}</span></legend>
                <div class="{% if is_swatch %}gh-swatches{% else %}gh-chips{% endif %}">
                  {%- for value in option.values -%}
                    {%- assign input_id = 'gh-' | append: section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                    {%- if is_swatch -%}
                      {%- assign swatch_media = nil -%}
                      {%- for v in product.variants -%}
                        {%- if v.options[option_index] == value and v.featured_media -%}{%- assign swatch_media = v.featured_media -%}{%- break -%}{%- endif -%}
                      {%- endfor -%}
                      {%- assign t = forloop.index0 | modulo: tone_count -%}
                      {%- assign a = forloop.index0 | modulo: art_count -%}
                      <label class="gh-swatch" for="{{ input_id }}">
                        <input type="radio" id="{{ input_id }}" name="gh-opt-{{ section.id }}-{{ option_index }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                        <span class="gh-swatch__img gh-media" style="--tone: {{ tones[t] | strip }}">
                          {%- if swatch_media -%}
                            {{ swatch_media | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
                          {%- else -%}
                            <span class="gh-ph">{% render 'gnarhead-art', face: art_keys[a] %}</span>
                          {%- endif -%}
                        </span>
                        <span class="gh-swatch__name">{{ value }}</span>
                      </label>
                    {%- else -%}
                      <label class="gh-chip" for="{{ input_id }}">
                        <input type="radio" id="{{ input_id }}" name="gh-opt-{{ section.id }}-{{ option_index }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                        <span>{{ value }}</span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          {%- if section.settings.show_bundles -%}
            <fieldset class="gh-field">
              <legend class="gh-field__legend">{{ section.settings.bundle_heading }}</legend>
              <div class="gh-bundles" data-gh-bundle>
                {%- for i in (1..3) -%}
                  {%- capture k_label -%}bundle_{{ i }}_label{%- endcapture -%}
                  {%- capture k_note -%}bundle_{{ i }}_note{%- endcapture -%}
                  {%- capture k_pct -%}bundle_{{ i }}_pct{%- endcapture -%}
                  {%- capture k_tag -%}bundle_{{ i }}_tag{%- endcapture -%}
                  <label class="gh-bundle">
                    <input type="radio" name="gh-bundle-{{ section.id }}" value="{{ i }}" data-pct="{{ section.settings[k_pct] }}" data-label="{{ section.settings[k_label] | escape }}" {% if i == section.settings.bundle_default %}checked{% endif %}>
                    <span class="gh-bundle__row">
                      <span class="gh-bundle__radio"></span>
                      <span>
                        <span class="gh-bundle__name">{{ section.settings[k_label] }}</span>
                        <span class="gh-bundle__note">{{ section.settings[k_note] }}</span>
                      </span>
                      <span class="gh-bundle__price"><span data-gh-bundle-now></span><s data-gh-bundle-was></s></span>
                    </span>
                    {%- if section.settings[k_tag] != blank -%}<span class="gh-bundle__tag">{{ section.settings[k_tag] }}</span>{%- endif -%}
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          <button type="submit" name="add" class="gh-atc" data-gh-atc {% unless current_variant.available %}disabled{% endunless %}>
            <span data-gh-atc-label>{% if current_variant.available %}{{ section.settings.atc_label }}{% else %}Sold out{% endif %}</span>
            <span class="gh-atc__price" data-gh-price>{{ current_variant.price | money }}</span>
          </button>
          {%- if section.settings.stock_line != blank -%}
            <p class="gh-stock"><span class="gh-stock__dot"></span>{{ section.settings.stock_line }}</p>
          {%- endif -%}
          {{ form | payment_terms }}
        {%- endform -%}

        <div class="gh-trust">
          <div>{% render 'gnarhead-icon', name: 'truck' %}{{ section.settings.trust_1 }}</div>
          <div>{% render 'gnarhead-icon', name: 'return' %}{{ section.settings.trust_2 }}</div>
          <div>{% render 'gnarhead-icon', name: 'lock' %}{{ section.settings.trust_3 }}</div>
        </div>

        <div class="gh-acc">
          {%- if product.description != blank -%}
            <details open><summary>Why you'll love it</summary><div class="gh-acc__body">{{ product.description }}</div></details>
          {%- endif -%}
          {%- if section.settings.materials != blank -%}
            <details><summary>Materials &amp; care</summary><div class="gh-acc__body">{{ section.settings.materials }}</div></details>
          {%- endif -%}
          {%- if section.settings.shipping != blank -%}
            <details><summary>Shipping &amp; returns</summary><div class="gh-acc__body">{{ section.settings.shipping }}</div></details>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ================= MARQUEE ================= {%- endcomment -%}
  {%- if section.settings.marquee != blank -%}
    {%- assign marquee_items = section.settings.marquee | split: '|' -%}
    <div class="gh-marquee" aria-hidden="true">
      <div class="gh-marquee__track">
        {%- for i in (1..4) -%}{%- for item in marquee_items -%}<span>{{ item | strip }}</span>{%- endfor -%}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ================= CREW ================= {%- endcomment -%}
  {%- if chars.size > 0 -%}
    <section class="gh-section gh-section--ice" id="gh-crew-{{ section.id }}">
      <div class="gh-wrap gh-head">
        <span class="gh-eyebrow">{{ section.settings.crew_eyebrow }}</span>
        <h2 class="gh-h2">{{ section.settings.crew_heading }}</h2>
        {%- if section.settings.crew_text != blank -%}<p class="gh-sub">{{ section.settings.crew_text }}</p>{%- endif -%}
      </div>
      <div class="gh-crew">
        {%- for block in chars -%}
          {%- assign t = forloop.index0 | modulo: tone_count -%}
          <article class="gh-char" {{ block.shopify_attributes }}>
            <div class="gh-char__media gh-media" style="--tone: {{ tones[t] | strip }}">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 20vw, 74vw', alt: block.settings.name }}
              {%- else -%}
                <div class="gh-ph">{% render 'gnarhead-art', face: block.settings.art %}</div>
              {%- endif -%}
            </div>
            <div class="gh-char__body">
              <h3 class="gh-char__name">{{ block.settings.name }}</h3>
              <p class="gh-char__line">{{ block.settings.line }}</p>
              {%- if block.settings.option_value != blank -%}
                <button type="button" class="gh-char__btn" data-gh-pick="{{ block.settings.option_value | escape }}">Choose {{ block.settings.name }}</button>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FEATURES + SPEC ================= {%- endcomment -%}
  {%- if features.size > 0 or specs.size > 0 -%}
    <section class="gh-section">
      <div class="gh-wrap">
        <div class="gh-head">
          <span class="gh-eyebrow">{{ section.settings.features_eyebrow }}</span>
          <h2 class="gh-h2">{{ section.settings.features_heading }}</h2>
        </div>
        {%- if features.size > 0 -%}
          <div class="gh-features">
            {%- for block in features -%}
              <div class="gh-feature" {{ block.shopify_attributes }}>
                <div class="gh-feature__icon">{% render 'gnarhead-icon', name: block.settings.icon %}</div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if specs.size > 0 -%}
          <div class="gh-spec">
            <div class="gh-spec__media gh-media">
              {%- if section.settings.spec_image -%}
                {{ section.settings.spec_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.spec_heading }}
              {%- else -%}
                <div class="gh-ph gh-ph--fill">{% render 'gnarhead-art', face: 'knit' %}</div>
              {%- endif -%}
            </div>
            <div class="gh-spec__card">
              <h3>{{ section.settings.spec_heading }}</h3>
              <table class="gh-spec__table"><tbody>
                {%- for block in specs -%}
                  <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.label }}</th><td>{{ block.settings.value }}</td></tr>
                {%- endfor -%}
              </tbody></table>
            </div>
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= COMPARISON ================= {%- endcomment -%}
  {%- if compares.size > 0 -%}
    <section class="gh-section gh-section--ice">
      <div class="gh-wrap">
        <div class="gh-head">
          <span class="gh-eyebrow">{{ section.settings.compare_eyebrow }}</span>
          <h2 class="gh-h2">{{ section.settings.compare_heading }}</h2>
        </div>
        <div class="gh-compare">
          <table>
            <thead><tr><th scope="col"><span class="visually-hidden">Feature</span></th><th scope="col" class="is-us">{{ shop.name }}</th><th scope="col">{{ section.settings.compare_them }}</th></tr></thead>
            <tbody>
              {%- for block in compares -%}
                <tr {{ block.shopify_attributes }}>
                  <td>{{ block.settings.label }}</td>
                  <td class="is-us"><span class="gh-yes">{% render 'gnarhead-icon', name: 'check' %}</span></td>
                  <td>{%- if block.settings.them -%}<span class="gh-yes">{% render 'gnarhead-icon', name: 'check' %}</span>{%- else -%}<span class="gh-no">{% render 'gnarhead-icon', name: 'x' %}</span>{%- endif -%}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FIELD FOOTAGE (only once videos exist) ================= {%- endcomment -%}
  {%- if has_footage -%}
    <section class="gh-section">
      <div class="gh-wrap gh-head">
        <span class="gh-eyebrow">{{ section.settings.reel_eyebrow }}</span>
        <h2 class="gh-h2">{{ section.settings.reel_heading }}</h2>
      </div>
      <div class="gh-reel">
        {%- for block in videos -%}
          {%- if block.settings.video != blank or block.settings.poster != blank -%}
            <figure class="gh-reel__item" {{ block.shopify_attributes }}>
              {%- if block.settings.video -%}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '540x' }}
              {%- else -%}
                {{ block.settings.poster | image_url: width: 540 | image_tag: loading: 'lazy', alt: block.settings.caption }}
              {%- endif -%}
              {%- if block.settings.caption != blank -%}<figcaption class="gh-reel__cap">{{ block.settings.caption }}</figcaption>{%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= REVIEWS (real customers only) ================= {%- endcomment -%}
  {%- if reviews.size > 0 -%}
    <section class="gh-section gh-section--ice">
      <div class="gh-wrap">
        <div class="gh-head"><span class="gh-eyebrow">Reviews</span><h2 class="gh-h2">{{ section.settings.reviews_heading }}</h2></div>
        <div class="gh-reviews">
          {%- for block in reviews -%}
            <figure class="gh-review" {{ block.shopify_attributes }}>
              {% render 'gnarhead-icon', name: 'stars' %}
              <blockquote>“{{ block.settings.text }}”</blockquote>
              <figcaption>{{ block.settings.name }}<span>✓ Verified buyer</span></figcaption>
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= GUARANTEE ================= {%- endcomment -%}
  {%- if section.settings.guarantee_heading != blank -%}
    <section class="gh-section">
      <div class="gh-wrap">
        <div class="gh-guarantee">
          <div class="gh-seal"><span><b>{{ section.settings.guarantee_days }}</b>day<br>guarantee</span></div>
          <div>
            <h2 class="gh-h2">{{ section.settings.guarantee_heading }}</h2>
            <p>{{ section.settings.guarantee_text }}</p>
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FAQ ================= {%- endcomment -%}
  {%- if faqs.size > 0 -%}
    <section class="gh-section gh-section--ice">
      <div class="gh-wrap">
        <div class="gh-head"><span class="gh-eyebrow">FAQ</span><h2 class="gh-h2">{{ section.settings.faq_heading }}</h2></div>
        <div class="gh-faq">
          {%- for block in faqs -%}
            <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="gh-faq__a">{{ block.settings.answer }}</div></details>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FINAL CTA ================= {%- endcomment -%}
  <section class="gh-final">
    <div class="gh-wrap">
      <h2 class="gh-h2">{{ section.settings.final_heading }}</h2>
      {%- if section.settings.final_text != blank -%}<p class="gh-sub">{{ section.settings.final_text }}</p>{%- endif -%}
      <button type="button" class="gh-atc" data-gh-submit-main data-gh-atc>
        <span data-gh-atc-label>{{ section.settings.atc_label }}</span><span class="gh-atc__price" data-gh-price>{{ current_variant.price | money }}</span>
      </button>
    </div>
    <div class="gh-final__art">
      <div class="gh-media">
        {%- if section.settings.final_image -%}
          {{ section.settings.final_image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', alt: '' }}
        {%- else -%}
          <div class="gh-ph gh-ph--lineup">{%- for k in art_keys -%}<span>{% render 'gnarhead-art', face: k %}</span>{%- endfor -%}</div>
        {%- endif -%}
      </div>
    </div>
  </section>

  <div class="gh-sticky" data-gh-sticky>
    <div>
      <div class="gh-sticky__title">{{ product.title }}</div>
      <div class="gh-sticky__sub"><span data-gh-sticky-sub>{{ current_variant.title }}</span> · <span data-gh-price>{{ current_variant.price | money }}</span></div>
    </div>
    <button type="button" class="gh-atc" data-gh-submit-main data-gh-atc>
      <span data-gh-atc-label>{{ section.settings.atc_label }}</span><span class="gh-atc__price" data-gh-price>{{ current_variant.price | money }}</span>
    </button>
  </div>

  <script type="application/json" data-gh-json>
    {
      "moneyFormat": {{ shop.money_format | json }},
      "strings": {
        "addToCart": {{ section.settings.atc_label | json }},
        "soldOut": "Sold out",
        "unavailable": "Unavailable",
        "save": "Save [percent]%"
      },
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "title": {{ v.title | json }},
            "options": {{ v.options | json }},
            "price": {{ v.price }},
            "compare_at_price": {{ v.compare_at_price | default: 0 }},
