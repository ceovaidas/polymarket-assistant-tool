{%- comment -%}
  Jolly Haul — product landing section.
  Works in any Online Store 2.0 theme (Dawn recommended). Assign the "product.landing"
  template to products that deserve a full landing page (e.g. the ski masks). Requires snippets/jolly-icon.liquid and snippets/jolly-art.liquid.
{%- endcomment -%}

{{ 'jolly.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jolly.js' | asset_url }}" defer></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count
  assign tones = section.settings.placeholder_tones | split: ','
  assign tone_count = tones.size
  assign tag_art = 'gift'
  for tag in product.tags
    if tag contains 'art-'
      assign tag_art = tag | remove_first: 'art-'
    endif
  endfor
  assign art_source = section.settings.art_order
  if art_source == blank
    assign art_source = tag_art
  endif
  assign art_keys = art_source | split: ','
  assign art_count = art_keys.size
  assign has_footage = false
  for b in section.blocks
    if b.type == 'video'
      if b.settings.video != blank or b.settings.poster != blank
        assign has_footage = true
      endif
    endif
  endfor
  assign chars = section.blocks | where: 'type', 'character'
  assign specs = section.blocks | where: 'type', 'spec'
  assign features = section.blocks | where: 'type', 'feature'
  assign videos = section.blocks | where: 'type', 'video'
  assign reviews = section.blocks | where: 'type', 'review'
  assign faqs = section.blocks | where: 'type', 'faq'
  assign compares = section.blocks | where: 'type', 'compare'
  assign bundles = section.blocks | where: 'type', 'bundle'
  assign perks = section.blocks | where: 'type', 'perk'
  assign slide_count = product.media.size
  if slide_count == 0
    assign slide_count = art_count
  endif
-%}

<div class="jh" data-jh-root id="jh-{{ section.id }}">

  {%- if section.settings.ticker != blank -%}
    {%- assign ticker_items = section.settings.ticker | split: '|' -%}
    <div class="jh-ticker" role="region" aria-label="{{ section.settings.ticker | replace: '|', ' · ' | escape }}">
      <div class="jh-ticker__track" aria-hidden="true">
        {%- for i in (1..4) -%}{%- for item in ticker_items -%}<span>{{ item | strip }}</span>{%- endfor -%}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ================= PRODUCT ================= {%- endcomment -%}
  <section class="jh-product">
    <nav class="jh-wrap jh-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>
      {%- if collection and collection.handle != 'all' -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">All gifts</a>
      {%- endif -%}
      <span aria-hidden="true">/</span><span aria-current="page">{{ product.title }}</span>
    </nav>
    <div class="jh-wrap jh-product__grid">

      <div class="jh-gallery">
        <div class="jh-gallery__frame">
          <div class="jh-gallery__track" data-jh-track>
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <figure class="jh-gallery__item jh-media" data-media-id="{{ media.id }}" {% if forloop.first %}data-jh-hero{% endif %}>
                  {%- if media.media_type == 'image' -%}
                    {%- if forloop.first -%}
                      {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                    {%- else -%}
                      {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                    {%- endif -%}
                  {%- elsif media.media_type == 'video' -%}
                    {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}
                  {%- else -%}
                    {{ media | media_tag }}
                  {%- endif -%}
                </figure>
              {%- endfor -%}
            {%- else -%}
              {%- for key in art_keys -%}
                {%- assign t = forloop.index0 | modulo: tone_count -%}
                <figure class="jh-gallery__item jh-media" style="--tone: {{ tones[t] | strip }}" {% if forloop.first %}data-jh-hero{% endif %}>
                  <div class="jh-ph">{% render 'jolly-art', face: key %}{% if request.design_mode %}<span class="jh-ph__cap">Upload photos in Products</span>{% endif %}</div>
                </figure>
              {%- endfor -%}
            {%- endif -%}
          </div>


          {%- if slide_count > 1 -%}
            <button type="button" class="jh-gallery__nav jh-gallery__nav--prev" data-jh-prev aria-label="Previous image">{% render 'jolly-icon', name: 'chev-left' %}</button>
            <button type="button" class="jh-gallery__nav jh-gallery__nav--next" data-jh-next aria-label="Next image">{% render 'jolly-icon', name: 'chev-right' %}</button>
            <div class="jh-dots" data-jh-dots>
              {%- for i in (1..slide_count) -%}
                <button type="button" aria-label="Image {{ i }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- if perks.size > 0 -%}
          <div class="jh-perks-overlay" aria-hidden="true">
            {%- for block in perks -%}
              <div class="jh-perk-chip" {{ block.shopify_attributes }}>{% render 'jolly-icon', name: block.settings.icon %}{{ block.settings.label }}</div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if slide_count > 1 -%}
          <div class="jh-thumbs" data-jh-thumbs>
            {%- if product.media.size > 0 -%}
              {%- for media in product.media limit: 6 -%}
                <button type="button" class="jh-thumb jh-media" aria-label="Show image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              {%- endfor -%}
            {%- else -%}
              {%- for key in art_keys limit: 6 -%}
                {%- assign t = forloop.index0 | modulo: tone_count -%}
                <button type="button" class="jh-thumb jh-media" style="--tone: {{ tones[t] | strip }}" aria-label="Show image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                  <span class="jh-ph">{% render 'jolly-art', face: key %}</span>
                </button>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="jh-buy">
        <div class="jh-buy__top">
          {%- if rating != blank -%}
            <span class="jh-rating">{% render 'jolly-icon', name: 'stars' %}{{ rating.rating | round: 1 }} · {{ rating_count }} reviews</span>
          {%- elsif section.settings.badge != blank -%}
            <span class="jh-pill">{% render 'jolly-icon', name: 'snow' %}{{ section.settings.badge }}</span>
          {%- endif -%}
        </div>

        <h1 class="jh-buy__title">{{ product.title }}</h1>
        {%- if section.settings.lede != blank -%}<p class="jh-buy__lede">{{ section.settings.lede }}</p>{%- endif -%}

        <div class="jh-price">
          <span class="jh-price__now" data-jh-price>{{ current_variant.price | money }}</span>
          <s class="jh-price__was" data-jh-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
          <span class="jh-price__save" data-jh-save hidden></span>
        </div>

        {%- if section.settings.hook != blank -%}
          <div class="jh-hook"><span class="jh-hook__emoji" aria-hidden="true">{{ section.settings.hook_emoji }}</span><span>{{ section.settings.hook }}</span></div>
        {%- endif -%}

        {%- assign gh_form_id = 'jh-form-' | append: section.id -%}
        {%- form 'product', product, id: gh_form_id, data-jh-form: 'true' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-jh-variant-id>
          <input type="hidden" name="quantity" value="1" data-jh-qty>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_index = forloop.index0 -%}
              {%- assign is_swatch = false -%}
              {%- if option.name == section.settings.swatch_option -%}{%- assign is_swatch = true -%}{%- endif -%}
              <fieldset class="jh-field" data-jh-option>
                <legend class="jh-field__legend">{{ option.name }}: <span data-jh-option-value="{{ option_index }}">{{ option.selected_value }}</span></legend>
                <div class="{% if is_swatch %}jh-swatches{% else %}jh-chips{% endif %}">
                  {%- for value in option.values -%}
                    {%- assign input_id = 'jh-' | append: section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                    {%- if is_swatch -%}
                      {%- assign swatch_media = nil -%}
                      {%- for v in product.variants -%}
                        {%- if v.options[option_index] == value and v.featured_media -%}{%- assign swatch_media = v.featured_media -%}{%- break -%}{%- endif -%}
                      {%- endfor -%}
                      {%- assign t = forloop.index0 | modulo: tone_count -%}
                      {%- assign a = forloop.index0 | modulo: art_count -%}
                      <label class="jh-swatch" for="{{ input_id }}">
                        <input type="radio" id="{{ input_id }}" name="jh-opt-{{ section.id }}-{{ option_index }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                        <span class="jh-swatch__img jh-media" style="--tone: {{ tones[t] | strip }}">
                          {%- if swatch_media -%}
                            {{ swatch_media | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
                          {%- else -%}
                            <span class="jh-ph">{% render 'jolly-art', face: art_keys[a] %}</span>
                          {%- endif -%}
                        </span>
                        <span class="jh-swatch__name">{{ value }}</span>
                      </label>
                    {%- else -%}
                      <label class="jh-chip" for="{{ input_id }}">
                        <input type="radio" id="{{ input_id }}" name="jh-opt-{{ section.id }}-{{ option_index }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                        <span>{{ value }}</span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          {%- if bundles.size > 0 -%}
            <fieldset class="jh-field">
              <legend class="jh-field__legend">{{ section.settings.bundle_heading }}</legend>
              <div class="jh-bundles" data-jh-bundle>
                {%- for block in bundles -%}
                  <label class="jh-bundle" {{ block.shopify_attributes }}>
                    <input type="radio" name="jh-bundle-{{ section.id }}" value="{{ block.settings.qty }}" data-pct="{{ block.settings.pct }}" data-label="{{ block.settings.label | escape }}" {% if forloop.index == section.settings.bundle_default %}checked{% endif %}>
                    <span class="jh-bundle__row">
                      <span class="jh-bundle__radio"></span>
                      <span>
                        <span class="jh-bundle__name">{{ block.settings.label }}</span>
                        <span class="jh-bundle__note">{{ block.settings.note }}</span>
                      </span>
                      <span class="jh-bundle__price"><span data-jh-bundle-now></span><s data-jh-bundle-was></s></span>
                    </span>
                    {%- if block.settings.tag != blank -%}<span class="jh-bundle__tag">{{ block.settings.tag }}</span>{%- endif -%}
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          <button type="submit" name="add" class="jh-atc" data-jh-atc {% unless current_variant.available %}disabled{% endunless %}>
            <span data-jh-atc-label>{% if current_variant.available %}{{ section.settings.atc_label }}{% else %}Sold out{% endif %}</span>
            <span class="jh-atc__price" data-jh-price>{{ current_variant.price | money }}</span>
          </button>
          {%- if section.settings.stock_line != blank -%}
            <p class="jh-stock"><span class="jh-stock__dot"></span>{{ section.settings.stock_line }}</p>
          {%- endif -%}
          {{ form | payment_terms }}
        {%- endform -%}

        <div class="jh-trust">
          <div>{% render 'jolly-icon', name: 'truck' %}{{ section.settings.trust_1 }}</div>
          <div>{% render 'jolly-icon', name: 'return' %}{{ section.settings.trust_2 }}</div>
          <div>{% render 'jolly-icon', name: 'lock' %}{{ section.settings.trust_3 }}</div>
        </div>

        <div class="jh-acc">
          {%- if product.description != blank -%}
            <details open><summary>Why you'll love it</summary><div class="jh-acc__body">{{ product.description }}</div></details>
          {%- endif -%}
          {%- if section.settings.materials != blank -%}
            <details><summary>Materials &amp; care</summary><div class="jh-acc__body">{{ section.settings.materials }}</div></details>
          {%- endif -%}
          {%- if section.settings.shipping != blank -%}
            <details><summary>Shipping &amp; returns</summary><div class="jh-acc__body">{{ section.settings.shipping }}</div></details>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ================= MARQUEE ================= {%- endcomment -%}
  {%- if section.settings.marquee != blank -%}
    {%- assign marquee_items = section.settings.marquee | split: '|' -%}
    <div class="jh-marquee" aria-hidden="true">
      <div class="jh-marquee__track">
        {%- for i in (1..4) -%}{%- for item in marquee_items -%}<span>{{ item | strip }}</span>{%- endfor -%}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ================= CREW ================= {%- endcomment -%}
  {%- if chars.size > 0 -%}
    <section class="jh-section jh-section--ice" id="jh-crew-{{ section.id }}">
      <div class="jh-wrap jh-head">
        <span class="jh-eyebrow">{{ section.settings.crew_eyebrow }}</span>
        <h2 class="jh-h2">{{ section.settings.crew_heading }}</h2>
        {%- if section.settings.crew_text != blank -%}<p class="jh-sub">{{ section.settings.crew_text }}</p>{%- endif -%}
      </div>
      <div class="jh-crew">
        {%- for block in chars -%}
          {%- assign t = forloop.index0 | modulo: tone_count -%}
          <article class="jh-char" {{ block.shopify_attributes }}>
            <div class="jh-char__media jh-media" style="--tone: {{ tones[t] | strip }}">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 20vw, 74vw', alt: block.settings.name }}
              {%- else -%}
                <div class="jh-ph">{% render 'jolly-art', face: block.settings.art %}</div>
              {%- endif -%}
            </div>
            <div class="jh-char__body">
              <h3 class="jh-char__name">{{ block.settings.name }}</h3>
              <p class="jh-char__line">{{ block.settings.line }}</p>
              {%- if block.settings.option_value != blank -%}
                <button type="button" class="jh-char__btn" data-jh-pick="{{ block.settings.option_value | escape }}">Choose {{ block.settings.name }}</button>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FEATURES + SPEC ================= {%- endcomment -%}
  {%- if features.size > 0 or specs.size > 0 -%}
    <section class="jh-section">
      <div class="jh-wrap">
        <div class="jh-head">
          <span class="jh-eyebrow">{{ section.settings.features_eyebrow }}</span>
          <h2 class="jh-h2">{{ section.settings.features_heading }}</h2>
        </div>
        {%- if features.size > 0 -%}
          <div class="jh-features">
            {%- for block in features -%}
              <div class="jh-feature" {{ block.shopify_attributes }}>
                <div class="jh-feature__icon">{% render 'jolly-icon', name: block.settings.icon %}</div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if specs.size > 0 -%}
          <div class="jh-spec">
            <div class="jh-spec__media jh-media">
              {%- if section.settings.spec_image -%}
                {{ section.settings.spec_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.spec_heading }}
              {%- else -%}
                <div class="jh-ph jh-ph--fill">{% render 'jolly-art', face: 'knit' %}</div>
              {%- endif -%}
            </div>
            <div class="jh-spec__card">
              <h3>{{ section.settings.spec_heading }}</h3>
              <table class="jh-spec__table"><tbody>
                {%- for block in specs -%}
                  <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.label }}</th><td>{{ block.settings.value }}</td></tr>
                {%- endfor -%}
              </tbody></table>
            </div>
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= COMPARISON ================= {%- endcomment -%}
  {%- if compares.size > 0 -%}
    <section class="jh-section jh-section--ice">
      <div class="jh-wrap">
        <div class="jh-head">
          <span class="jh-eyebrow">{{ section.settings.compare_eyebrow }}</span>
          <h2 class="jh-h2">{{ section.settings.compare_heading }}</h2>
        </div>
        <div class="jh-compare">
          <table>
            <thead><tr><th scope="col"><span class="visually-hidden">Feature</span></th><th scope="col" class="is-us">{{ shop.name }}</th><th scope="col">{{ section.settings.compare_them }}</th></tr></thead>
            <tbody>
              {%- for block in compares -%}
                <tr {{ block.shopify_attributes }}>
                  <td>{{ block.settings.label }}</td>
                  <td class="is-us"><span class="jh-yes">{% render 'jolly-icon', name: 'check' %}</span></td>
                  <td>{%- if block.settings.them -%}<span class="jh-yes">{% render 'jolly-icon', name: 'check' %}</span>{%- else -%}<span class="jh-no">{% render 'jolly-icon', name: 'x' %}</span>{%- endif -%}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FIELD FOOTAGE (only once videos exist) ================= {%- endcomment -%}
  {%- if has_footage -%}
    <section class="jh-section">
      <div class="jh-wrap jh-head">
        <span class="jh-eyebrow">{{ section.settings.reel_eyebrow }}</span>
        <h2 class="jh-h2">{{ section.settings.reel_heading }}</h2>
      </div>
      <div class="jh-reel">
        {%- for block in videos -%}
          {%- if block.settings.video != blank or block.settings.poster != blank -%}
            <figure class="jh-reel__item" {{ block.shopify_attributes }}>
              {%- if block.settings.video -%}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '540x' }}
              {%- else -%}
                {{ block.settings.poster | image_url: width: 540 | image_tag: loading: 'lazy', alt: block.settings.caption }}
              {%- endif -%}
              {%- if block.settings.caption != blank -%}<figcaption class="jh-reel__cap">{{ block.settings.caption }}</figcaption>{%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= REVIEWS (real customers only) ================= {%- endcomment -%}
  {%- if reviews.size > 0 -%}
    <section class="jh-section jh-section--ice">
      <div class="jh-wrap">
        <div class="jh-head"><span class="jh-eyebrow">Reviews</span><h2 class="jh-h2">{{ section.settings.reviews_heading }}</h2></div>
        <div class="jh-reviews">
          {%- for block in reviews -%}
            <figure class="jh-review" {{ block.shopify_attributes }}>
              {% render 'jolly-icon', name: 'stars' %}
              <blockquote>“{{ block.settings.text }}”</blockquote>
              <figcaption>{{ block.settings.name }}<span>✓ Verified buyer</span></figcaption>
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= GUARANTEE ================= {%- endcomment -%}
  {%- if section.settings.guarantee_heading != blank -%}
    <section class="jh-section">
      <div class="jh-wrap">
        <div class="jh-guarantee">
          <div class="jh-seal"><span><b>{{ section.settings.guarantee_days }}</b>day<br>guarantee</span></div>
          <div>
            <h2 class="jh-h2">{{ section.settings.guarantee_heading }}</h2>
            <p>{{ section.settings.guarantee_text }}</p>
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FAQ ================= {%- endcomment -%}
  {%- if faqs.size > 0 -%}
    <section class="jh-section jh-section--ice">
      <div class="jh-wrap">
        <div class="jh-head"><span class="jh-eyebrow">FAQ</span><h2 class="jh-h2">{{ section.settings.faq_heading }}</h2></div>
        <div class="jh-faq">
          {%- for block in faqs -%}
            <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="jh-faq__a">{{ block.settings.answer }}</div></details>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FINAL CTA ================= {%- endcomment -%}
  <section class="jh-final">
    <div class="jh-snow" aria-hidden="true"></div>
    <div class="jh-wrap">
      <h2 class="jh-h2">{{ section.settings.final_heading }}</h2>
      {%- if section.settings.final_text != blank -%}<p class="jh-sub">{{ section.settings.final_text }}</p>{%- endif -%}
      <button type="button" class="jh-atc" data-jh-submit-main data-jh-atc>
        <span data-jh-atc-label>{{ section.settings.atc_label }}</span><span class="jh-atc__price" data-jh-price>{{ current_variant.price | money }}</span>
      </button>
    </div>
    <div class="jh-final__art">
      <div class="jh-media">
        {%- if section.settings.final_image -%}
          {{ section.settings.final_image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', alt: '' }}
        {%- else -%}
          <div class="jh-ph jh-ph--lineup">{%- for k in art_keys -%}<span>{% render 'jolly-art', face: k %}</span>{%- endfor -%}</div>
        {%- endif -%}
      </div>
    </div>
  </section>

  <div class="jh-sticky" data-jh-sticky>
    <div>
      <div class="jh-sticky__title">{{ product.title }}</div>
      <div class="jh-sticky__sub"><span data-jh-sticky-sub>{{ current_variant.title }}</span> · <span data-jh-price>{{ current_variant.price | money }}</span></div>
    </div>
    <button type="button" class="jh-atc" data-jh-submit-main data-jh-atc>
      <span data-jh-atc-label>{{ section.settings.atc_label }}</span><span class="jh-atc__price" data-jh-price>{{ current_variant.price | money }}</span>
    </button>
  </div>

  <script type="application/json" data-jh-json>
    {
      "moneyFormat": {{ shop.money_format | json }},
      "strings": {
        "addToCart": {{ section.settings.atc_label | json }},
        "soldOut": "Sold out",
        "unavailable": "Unavailable",
        "save": "Save [percent]%"
      },
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "title": {{ v.title | json }},
            "options": {{ v.options | json }},
            "price": {{ v.price }},
            "compare_at_price": {{ v.compare_at_price | default: 0 }},
            "available": {{ v.available }},
            "image": {% if v.featured_media %}{{ v.featured_media | image_url: width: 1600 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</div>

