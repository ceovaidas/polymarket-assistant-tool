{%- comment -%}
  Jolly Haul — footer. Replaces Dawn's footer in sections/footer-group.json.
  Brand + promises · shop categories (empty collections hide) · help menu · bottom bar with payments and policies.
{%- endcomment -%}

{{ 'jolly.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign brand = section.settings.brand_name | default: shop.name
  assign help_menu = linklists[section.settings.help_menu]
  assign shop_handles = section.settings.shop_links | remove: ' ' | split: ','
-%}

<div class="jh jh-toast-wrap"><div class="jh-toast" data-jh-toast data-jh-added="{{ 'jolly.card.added_short' | t | escape }}" role="status" aria-live="polite" hidden>
  <span class="jh-toast__thumb" data-jh-toast-thumb hidden><img src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt="" width="48" height="48"></span>
  <span class="jh-toast__icon">{% render 'jolly-icon', name: 'check' %}</span>
  <span class="jh-toast__text"><b>{{ 'jolly.card.added' | t }}</b><small data-jh-toast-title></small></span>
  <a class="jh-toast__cta" href="{{ routes.cart_url | default: '/cart' }}">{{ 'jolly.card.view_cart' | t }}</a>
</div></div>
<footer class="jh jh-footer">
  <div class="jh-lights jh-footer__lights" aria-hidden="true"></div>
  <div class="jh-wrap">
    <div class="jh-footer__grid">
      <div class="jh-footer__brand">
        <a class="jh-logo jh-footer__logo" href="{{ routes.root_url }}" aria-label="{{ brand | escape }}">
          <span>jolly<b>haul</b></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.6 6 6.4.6-4.9 4.3 1.5 6.3L12 16.4 6.4 19.7l1.5-6.3L3 9.1l6.4-.6z" fill="#f2b33d"/></svg>
        </a>
        {%- if section.settings.tagline != blank -%}<p class="jh-footer__tag">{{ section.settings.tagline }}</p>{%- endif -%}
        <ul class="jh-footer__promises">
          <li>{% render 'jolly-icon', name: 'truck' %}{{ 'jolly.footer.promise_ship' | t }}</li>
          <li>{% render 'jolly-icon', name: 'return' %}{{ 'jolly.cart.trust_returns' | t }}</li>
          <li>{% render 'jolly-icon', name: 'lock' %}{{ 'jolly.cart.trust_secure' | t }}</li>
        </ul>
        {%- if section.settings.instagram != blank or section.settings.tiktok != blank or section.settings.facebook != blank -%}
          <div class="jh-footer__social">
            {%- if section.settings.tiktok != blank -%}
              <a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-1.8-2.5V9.7a5.7 5.7 0 1 0 4.9 5.7V9.1a7.3 7.3 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.2-1.6z"/></svg></a>
            {%- endif -%}
            {%- if section.settings.instagram != blank -%}
              <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
            {%- endif -%}
            {%- if section.settings.facebook != blank -%}
              <a href="{{ section.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21z"/></svg></a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <nav class="jh-footer__col" aria-label="Shop">
        <h2 class="jh-footer__h">{{ 'jolly.footer.shop' | t }}</h2>
        <ul>
          {%- for h in shop_handles -%}
            {%- if h == 'all' -%}
              <li><a href="{{ routes.all_products_collection_url }}">{{ 'jolly.common.all_gifts' | t }}</a></li>
            {%- else -%}
              {%- assign c = collections[h] -%}
              {%- if c == blank or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
              <li><a href="{{ c.url }}">{{ c.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>

      <nav class="jh-footer__col" aria-label="Help">
        <h2 class="jh-footer__h">{{ 'jolly.footer.help' | t }}</h2>
        <ul>
          {%- for link in help_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- if section.settings.email != blank -%}
            <li><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>
          {%- endif -%}
        </ul>
      </nav>

      <div class="jh-footer__col jh-footer__card">
        <h2 class="jh-footer__h">{{ section.settings.card_heading }}</h2>
        <p>{{ section.settings.card_text }}</p>
        <a class="jh-btn jh-btn--sun" href="{{ section.settings.card_link | default: routes.all_products_collection_url }}">{{ section.settings.card_button }}</a>
      </div>
    </div>

    <div class="jh-footer__bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ brand }}. {{ 'jolly.footer.rights' | t }}</p>
      {% render 'jolly-localization', id: 'footer' %}
      {%- if section.settings.show_payments and shop.enabled_payment_types.size > 0 -%}
        <ul class="jh-footer__pay" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      <ul class="jh-footer__legal">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Jolly Haul footer",
  "tag": "div",
  "class": "jh-footer-wrapper",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Jolly Haul", "info": "Shown in the copyright line." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Viral Christmas finds that make people laugh, gasp and ask where you got them." },
    { "type": "text", "id": "shop_links", "label": "Shop column (collection handles)", "default": "all,new-arrivals,trending,gifts-under-25,funny-masks,baby-kids,pets,cozy-travel,star-projectors,ugly-sweaters,lights-decor,stocking-stuffers", "info": "Comma-separated. Empty collections are hidden automatically." },
    { "type": "link_list", "id": "help_menu", "label": "Help column menu", "default": "footer" },
    { "type": "text", "id": "email", "label": "Support email" },
    { "type": "text", "id": "card_heading", "label": "Card heading", "default": "Still hunting for the perfect gift?" },
    { "type": "text", "id": "card_text", "label": "Card text", "default": "Mix & match: buy 2 gifts and save 10%, 3 or more and save 15%." },
    { "type": "text", "id": "card_button", "label": "Card button", "default": "Shop all gifts" },
    { "type": "url", "id": "card_link", "label": "Card button link" },
    { "type": "url", "id": "tiktok", "label": "TikTok URL" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "facebook", "label": "Facebook URL" },
    { "type": "checkbox", "id": "show_payments", "label": "Show payment icons", "default": true }
  ]
}
{% endschema %}
